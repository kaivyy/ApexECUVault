%%CONSTANT%%
	000002 UniqueID         =0x3A68
	000100 Cat0ID           =0x1
	020005 Title            ="==== READ ME !!!! (Item Comments) =================="
	020011 DescSize         =0x372
	020010 Desc             ="Thanks for using this xdf! I hope it will make tuning easier. When I first began tuning I  struggled with incomplete xdf files not knowing what all there was that could be adjusted to help with the problems I was experiencing. With this xdf you should not have that problem, this xdf contains much more than what will ever need to be changed. In fact many of the items should not be changed. Please be careful!\r\n\r\nPlease make use of the \"Item Comments\". These can be viewed by clicking the \"Show Item Comments\" button in the tool bar at the top of the screen.\r\n\r\nPlease make use of the \"Visibility and Category View Filters\" in the tool bar at the top of the screen. This feature will make using this xdf much easier. Two levels are available, Level 1 and Level 10. Level 1 displays the most basic and most used parameters. Level 10 displays all parameters. \r\n\r\nGood Luck!\r\n93V8S10"
	020020 Units            =""
	020100 Address          =0x0
	020200 Equation         =X,TH|0|0|0|0|
%%END%%

%%CONSTANT%%
	000002 UniqueID         =0x4BFA
	000100 Cat0ID           =0x1
	020005 Title            ="==== DISCLAIMER (Item Comments) =================="
	020011 DescSize         =0xD3
	020010 Desc             ="Disclaimer:\r\n\r\nI make no guarantee as to the accuracy of this file. Use at your own risk! If you break your vehicle, fail emissions testing, or etc…, the fault is yours and no one else's.\r\n\r\nGood Luck!\r\n93V8S10"
	020020 Units            =""
	020100 Address          =0x0
	020200 Equation         =X,TH|0|0|0|0|
%%END%%

