    "Bedingung Bremstestschalter bet‰tigt"
    UBYTE
    B_TRUE
    1
    100
    0
    1

    BIT_MASK 0x1
    FORMAT "%13.11"
    
    ECU_ADDRESS 0x3FBDB2
    /begin IF_DATA ASAP1B_CCP KP_BLOB 0x00 0x3FBDB2 1 /end IF_DATA
    /begin IF_DATA ASAP1B_ADDRESS  KP_BLOB 0x3FBDB2 /end IF_DATA
    /begin IF_DATA ETK  KP_BLOB 0x3FBDB2 INTERN 0x1 /end IF_DATA
    /begin IF_DATA ASAP1B_KWP2000  KP_BLOB  0x3FBDB2  INTERN  0x1  /end IF_DATA 

/end MEASUREMENT

