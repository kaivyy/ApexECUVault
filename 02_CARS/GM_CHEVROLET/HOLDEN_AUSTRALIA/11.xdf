	030010 Desc             ="Bit 0   1 = Reset fuel integerator if in AE\r\nBit 1   1 = Reset fuel integerator if BLM cell change\r\nBit 2   1 = Reset fuel integerator if in DE\r\nBit 3   1 = Chose MAP as load criteria for BLM logic  0 = Chose TPS as load criteria for BLM logic\r\nBit 4   1 ="
	030100 Address          =0x8003
	030200 BitNumber        =0x0
%%END%%

