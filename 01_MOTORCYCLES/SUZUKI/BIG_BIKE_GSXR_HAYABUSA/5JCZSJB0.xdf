  <XDFCONSTANT uniqueid="0xE00B" flags="0x0">
    <title>ALS Min Coolant Temp</title>
    <description>ALS will not arm below this coolant temperature (RAM 0xFEF026BD). Default 60 C. @0xBF001</description>
    <CATEGORYMEM index="0" category="38" />
    <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0xBF001" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
