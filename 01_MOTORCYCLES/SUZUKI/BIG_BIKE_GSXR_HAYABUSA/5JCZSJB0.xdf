      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0xE00E" flags="0x0">
    <title>ALS Release Grip Angle</title>
    <description>Grip below this while active releases ALS; re-opening past the capture angle re-captures. Keep below capture. Default 60. @0xBF006</description>
    <CATEGORYMEM index="0" category="38" />
    <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0xBF006" mmedelementsizebits="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
