	020005 Title            ="Desired AFR"
	020011 DescSize         =0x146
	020010 Desc             ="Title: Desired AFR\r\n\r\nLocation: 5214, 5215\r\n\r\nUsage: Desired AFR Data logging\r\n\r\nTips: To data log \"Desired AFR\" instead of \"Battery Volts\", change the value at this location to $026D \"Desired AFR\". Stock value is $0A7 ($00A7) \"Battery Volts\". Ads file can be changed to reflect this change, if desired.\r\n\r\nConversion: None\r\n"
