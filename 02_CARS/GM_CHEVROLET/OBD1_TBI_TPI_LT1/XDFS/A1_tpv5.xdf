  <XDFTABLE uniqueid="0x6A65" flags="0x0">
    <title>Mode 0/7 Address Transmit Table 1</title>
    <description>   1          IPMW9           MODE WORD FOR INSTRUMENT PANEL&#013;&#010;          0     NOT USED&#013;&#010;          1     NOT USED&#013;&#010;          2     NOT USED&#013;&#010;          3     NOT USED&#013;&#010;          4      1 = DIAGNOSTIC ENABLE LINE SHORTED&#013;&#010;          5      1 = ALDL MODE&#013;&#010;          6      1 = SERVICE ENGINE SOON LIGHT ON&#013;&#010;          7      1 = UP SHIFT LIGHT ON&#013;&#010;   2          NEWRPM          RPM IN PREVIOUS 12.5 MS (MSB)&#013;&#010;   3          NEWRPM+1        RPM IN PREVIOUS 12.5 MS (LSB)&#013;&#010;                                  RPM = MSB*256 + LSB</description>
    <CATEGORYMEM index="0" category="24" />
    <XDFAXIS id="x" uniqueid="0x0">
