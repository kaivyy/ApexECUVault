      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0xE00C" flags="0x0">
    <title>ALS Min Rolling Speed</title>
    <description>ALS arms only while FRONT wheel speed (0xFEF0263A) is at or above this; below it START stays stock. Default 20. @0xBF002</description>
    <CATEGORYMEM index="0" category="38" />
    <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0xBF002" mmedelementsizebits="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
