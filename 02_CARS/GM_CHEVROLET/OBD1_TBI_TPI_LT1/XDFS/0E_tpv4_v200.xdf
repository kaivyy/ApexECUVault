	000100 Cat0ID           =0x1
	000101 Cat1ID           =0xB
	030005 Title            ="De-Latch"
	030011 DescSize         =0xE1
	030010 Desc             ="Title: De-Latch\r\n\r\nLocation: 400B-Bit 7\r\n\r\nUsage: Air Fuel Mode Words \r\n\r\nTips: Skip delta TPS check when already in deceleration enleanment. Checkmark to enable. I4 and V8 bins are normally off. V6 bins are normally on.  \r\n"
	030100 Address          =0x400B
	030200 BitNumber        =0x7
%%END%%

%%FLAG%%
	000002 UniqueID         =0x23AA
	000004 VisLevel         =0xA
	000100 Cat0ID           =0x1
	030005 Title            ="MAT Sensor"
	030011 DescSize         =0xCB
	030010 Desc             ="Title: MAT Sensor\r\n\r\nLocation: 400B-Bit 6\r\n\r\nUsage: Air Fuel Mode Words \r\n\r\nTips: Enables MAT sensor calibrations. Checkmark to enable MAT sensor calibrations. This can also be used for a IAT sensor. \r\n"
	030100 Address          =0x400B
	030200 BitNumber        =0x6
%%END%%

%%FLAG%%
