    "Ableich Momentenstati (empfangener Status vom anderen SG))"
    UWORD
    OneToOne
    1
    100
    0.00
    65535.00

    
    FORMAT "%8.2"
    
    ECU_ADDRESS 0x7F90D8
    /begin IF_DATA ASAP1B_CCP
	    KP_BLOB
		  0x00
		  0x7F90D8
		  0x2
    /end IF_DATA
    /begin IF_DATA ETK 
	    KP_BLOB 
		  0x7F90D8 
          0 
		  0x2 
    /end IF_DATA 
    /begin IF_DATA ASAP1B_KWP2000 
	    KP_BLOB 
		  0x7F90D8 
          INTERN 
		  0x2 
    /end IF_DATA 
    /begin IF_DATA ASAP1B_MCMESS 
	    /begin KP_BLOB 
		  0x7F90D8 
          INTERN 
		  0x2 
	    /end KP_BLOB 
    /end IF_DATA 

/end MEASUREMENT

