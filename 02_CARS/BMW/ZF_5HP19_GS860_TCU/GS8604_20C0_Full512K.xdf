      <EMBEDDEDDATA mmedtypeflags="0x00" mmedaddress="0x71ADA" mmedelementsizebits="8" mmedcolcount="9" mmedmajorstridebits="0" mmedminorstridebits="0" />
      <units>педаль коробки</units>
