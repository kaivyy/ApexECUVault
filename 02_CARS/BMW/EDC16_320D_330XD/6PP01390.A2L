/* Erstellt von DAMOS++ V1.19E-2 SunOS */
/begin PROJECT P390 "BMW DDE6.2 6-Zylinder VP0.1 11.11.2003 CAN12H"
  /begin HEADER ""
    VERSION    "VP01_6Z_CAN12H"
    PROJECT_NO P390
  /end HEADER

  /begin MODULE DIM ""

  /begin A2ML 
    block "IF_DATA" taggedunion if_data {
/***************************************************************************/
/*                                                                         */
/*   ASAP2 Meta Language for Bypass                                        */
/*   assumes ASAP2 V1.31                                                   */
/*                                                                         */
/*   AML Version V1.0, 05.04.2000                                          */
/*                                                                         */
/*   Change History:                                                       */
/*                                                                         */
/*   Version  Date        Author               Modification                */
/*   ===================================================================   */
/*   V1.0     05.04.2000  K5/ESQ2-Ocker        first release               */
/*   -------------------------------------------------------------------   */
/*   V0.3     02.03.2000  K5/ESQ2-Ocker        changed order of KP_BLOB    */
/*                                             parameters;                 */
/*                                             meaning of SOURCE_ID        */
/*                                             changed;                    */
/*                                             editorial modifications     */
/*   -------------------------------------------------------------------   */
/*   V0.2     14.02.2000  K5/ESQ2-Ocker        + source identifier         */
/*   -------------------------------------------------------------------   */
/*   V0.1     06.12.1999  K5/ESQ2-Ocker        initial draft               */
/*                                                                         */
/*   Robert Bosch GmbH, K5/ESQ2-Ocker                                      */
/*                                                                         */
/***************************************************************************/

"ASAP1B_Bypass" taggedstruct {

    (block "SOURCE" struct {
        struct {
            char[101];  /* source name                                     */
            int;        /* period definition: basic scaling unit in CSE    */
                        /* defined in ASAP1b (CSE = code for scaling unit) */
            long;       /* period definition: rate in scaling units        */
        };
        taggedstruct {
            block "QP_BLOB" struct {
                uint;   /* source identifier                               */
            };
        };
    })*;

    block "TP_BLOB" struct {
        uint;           /* Bypass Version, High Byte: Version              */
                        /*                 Low Byte : subversion (dec.)    */
        uint;           /* Blob Version,   High Byte: Version              */
                        /*                 Low Byte : subversion (dec.)    */
    };

    block "DP_BLOB" struct {
    };

    block "PA_BLOB" struct {
    };

    block "KP_BLOB" struct {
        taggedstruct {

            "BUFFER_OFFSET"    char[256];  /* parameter value represents   */
                                           /* switch: 0 = bypass disabled, */
                                           /*         1 = bypass enabled   */

            "SOURCE_ID"        char[256];  /* parameter value represents   */
                                           /* stimulus channel             */

            "BIT_OFFSET"       char[256];  /* parameter value represents   */
                                           /* mask in case of bit objects  */

            "POSSIBLE_SOURCES" ( uint )*;  /* list of all channels, where  */
                                           /* intervention point is usable */
                         /* special cases:                                 */
                         /* empty list = intervention point is defined,    */
                         /*              but unusable                      */
                         /* keyword omitted = intervention point is usable */
                         /*                   in all available channels    */
        };
    };

}; /* end of taggedstruct "ASAP1B_Bypass" */

      /* --> file ccp_v2_3.aml by ETAS */
      /****************************************************************************/
      /*                                                                          */
      /*   ASAP2 Meta Language for CCP CAN Calibration Protocol V2.1              */
      /*   Assumes ASAP2 V1.3 or later                                            */
      /*                                                                          */
      /*   AML Version V2.3, 13.10.1998                                           */
      /*                                                                          */
      /*   Vector Informatik, Zaiser                                              */
      /*   Hewlett Packard, Krueger                                               */
      /*   ETAS, Maier                                                            */
      /*   SIEMENS Automotive, Stuhler                                            */
      /*                                                                          */
      /*   Datatypes:                                                             */
      /*                                                                          */
      /*   A2ML       ASAP2          Windows  Erlaeuuterung                       */
      /*   ----------------------------------------------------------------       */
      /*   uchar      UBYTE          BYTE     unsigned 8 Bit                      */
      /*   char       SBYTE          char     signed 8 Bit                        */
      /*   uint       UWORD          WORD     unsigned integer 16 Bit             */
      /*   int        SWORD          int      signed integer 16 Bit               */
      /*   ulong      ULONG          DWORD    unsigned integer 32 Bit             */
      /*   long       SLONG          LONG     signed integer 32 Bit               */
      /*   float      FLOAT32_IEEE            float 32 Bit                        */
      /*                                                                          */
      /****************************************************************************/
      
        "ASAP1B_CCP" taggedstruct {
      
          /* Beschreibung der DAQ-Listen */
          (block "SOURCE" struct {
      
            struct {
              char [101];   /* Name of the DAQ-List (data acquisition list),
                               measurement source .        */
      
                            /* If the DAQ-Liste only supports one fixed ECU 
                               sampling rate, it can be declared below
                               to achieve compatibility with the ASAP2 standard.
                               Otherwise description of the possible ECU
                               sampling rates in QP_BLOB      */
              int;          /* Period definition : Basic scaling unit in 
                               CSE defined in ASAP1b (CSE=Code for Scaling Unit) */
              long;         /* Period definition : Rate in Scaling Units */
            };
      
      
            taggedstruct {
      
              "DISPLAY_IDENTIFIER" char[32];
      
              block "QP_BLOB" struct {
      
                uint;	               /* Number of the DAQ-List 0..n                */
      
                taggedstruct {
                  "LENGTH" uint;     /* Length of the DAQ-Liste, maximum number of
                                        the useable ODTs                           */
      
                  "CAN_ID_VARIABLE";
                                     /* CAN-Message-ID is variable             */
      
                  "CAN_ID_FIXED" ulong;
                                     /* CAN-Message-ID of the DTOs is fixed,
                                        Default DTO
                                        Bit31 = 1: extended Identifier
                                        Bit31 = 0: standard Identifier             */
      
                                     /* Not applied if the ECU uses the DTM-Id    */
      
                  ("RASTER" uchar; )*;
                                     /* Supported CCP Event Channel Names 
                                        of this DAQ List */ 
      
                  ("EXCLUSIVE" int; )*;
                                     /* Exclusion of other DAQ-Lists              */
      
                  "REDUCTION_ALLOWED";
                                     /* Data reduction possible                   */
      
                  "FIRST_PID" uchar;     /* First Packet ID (PID) of the DAQ List */
                };
              };
            };
          }; )*;
      
      
          /* Description of the available ECU Sampling Rates (Event Channels)      */
          (block "RASTER" struct {
      
             char [101];   /* CCP Event Channel Name                               */
             char [9];     /* Short Display Name of the Event Channel Name         */
             uchar;        /* Event Channel No., used for CCP START_STOP)          */
             int;          /* Period definition :  basic scaling unit in CSE  
                              as defined in ASAP1b                                 */
             long;         /* ECU sample rate of the event channel, 
                              period definition based on the basic scaling unit    */
      
             taggedstruct {
               ("EXCLUSIVE" uchar; )*;
                           /* Exclusion of other CCP Event Channels                */
             };
      
          }; )*;
      
          /* Group several event channels to form one combined event */
          /* e.g. group all cylinder synchronous events to one combined element */
          (block "EVENT_GROUP" struct {
      
             char [101];   /* Event group name */
             char [9];     /* Short name for the event group */
             taggedstruct {
               ("RASTER" uchar; )*;
             };
                           /* all event channels beloging to group
                              (CCP Event Channel Numbers for START_STOP)               */
          }; )*;
      
      
          /* Description of the authentification process */
          block "SEED_KEY" struct {
             char[256];    /* Name of the Seed&Key DLL for CAL Priviledge, 
                              including file-Extension without path */
             char[256];    /* Name of the Seed&Key DLL for DAQ Priviledge,
                              including file-Extension without path */
             char[256];    /* Name of the Seed&Key DLL for PGM Priviledge, 
                              including file-Extension without path */
          };
      
      
      /* Description of the checksum calculation process */
          block "CHECKSUM" struct {
             char[256];    /* Name of the Checksum DLL representing the ECU Algorithm, 
                              including file-Extension without path */
      };
      
      
      block "TP_BLOB" struct {
      
            uint;	  /* CCP Version,       High Byte: Version
                                          Low Byte : subversion (dec.)            */
            uint;	  /* Blob-Version,      High Byte: Version
                                          Low Byte : subversion (dec.)            */
            ulong;	  /* CAN-Message ID for 'Transmitting to ECU (CRM)'
                                          Bit31 = 1: extended Identifier
                                          Bit31 = 0: standard Identifier          */
            ulong;	  /* CAN-Message ID for 'Receiving from ECU (DTM)'
                                          Bit31 = 1: extended Identifier
                                          Bit31 = 0: standard Identifier          */
            uint;	  /* Logical CCP-Address of the (station address)           */
            uint;	  /* Byte order of Multiple-byte-items
                                          1 = high Byte first, 2 = low byte first */
            taggedstruct {
      
              block "CAN_PARAM" struct {
                uint;                  /* Quartz freq. of the elec. control unit  */
                uchar;                 /* BTR0                                    */
                uchar;                 /* BTR1                                    */
              };
      
              "BAUDRATE" ulong;	       /* Baud rate in Hz.                           */
              "SAMPLE_POINT" uchar;    /* sampling point of time in percent       */
              "SAMPLE_RATE" uchar;     /* number of samples per Bit (1 oder 3)    */
              "BTL_CYCLES" uchar;      /* number of BTL-cycles                    */
              "SJW" uchar;             /* SJW-parameter in BTL-cycles             */
              "SYNC_EDGE" enum {
                 "SINGLE" = 0,         /* Synchronisation only on fallende edge   */
                 "DUAL" = 1            /* Synchr. on falling and rising edge      */
              };
      
              "DAQ_MODE" enum {        /* mode of cylcic data acquisition         */
                 "ALTERNATING" = 0,    /* ECU is sending one ODT per cycle        */
                 "BURST" = 1           /* ECU is sending a complete DAQ           */
              };
      
              "BYTES_ONLY";            /* ECU supports max. elements of one Byte size */
      
              "RESUME_SUPPORTED";      /* ECU supports the Resume function       */
              "STORE_SUPPORTED";       /* ECU supports the Store function        */
      
              "CONSISTENCY" enum {
                 "DAQ" = 0,            /* consistency of a complete DAQ ist guaranteed */
                 "ODT" = 1             /* consistency of a complete ODT ist guaranteed */
              };
      
              "ADDRESS_EXTENSION" enum {  /* address extension                      */
                 "DAQ" = 0,               /* ECU supports only one Address extension
                                             within an DAQ                    */
                 "ODT" = 1                /* ECU supports only one Address extension
                                             within an ODT                    */
              };
      
              block "CHECKSUM_PARAM" struct {
                uint;	           /* checksum calculation procedure
                                     standard types not yet defined,
                                     if greater of equal 1000 : manufacturer specific  */
      
                ulong;               /* Maximum block length used by an ASAP1a-CCP 
                                        command, for checksum calculation procedure  */
      
                taggedstruct {
                  "CHECKSUM_CALCULATION" enum {
                     "ACTIVE_PAGE" = 0,
                     "BIT_OR_WITH_OPT_PAGE" = 1
                  };
                };
              };
      
              (block "DEFINED_PAGES" struct {
                 struct {
                    uint;            /* Logical No. of the memory page (1,2,..)   */
                    char[101];       /* Name of the memory page                   */
                    uint;            /* Adress-Extension of the memory page (only 
                                        Low Byte significant)                     */
                    ulong;           /* Base address of the memory page           */
                    ulong;           /* Length of the memory page in Bytes         */
                 };
                 taggedstruct {
                   "RAM";              /* memory page in RAM */
                   "ROM";              /* memory page in ROM */
                   "FLASH";            /* memory page in FLASH */
                   "EEPROM";           /* memory page in EEPROM */
                   "RAM_INIT_BY_ECU";  /* memory page is initialised by ECU start-up */
                   "RAM_INIT_BY_TOOL"; /* RAM- memory page is initialised by the MCD
                                          system */
                   "AUTO_FLASH_BACK";  /* RAM memory page is automatically flashed back */
                   "FLASH_BACK";       /* feature available to flash back the RAM memory page */
                   "DEFAULT";          /* memory page is standard (fallback mode) */
                 };
              }; ) *;
      
              ( "OPTIONAL_CMD"  uint; )*; /* CCP-Code of the optional command available 
                                             in the ECU. It is recommended to declare all
                                             non-standard ECU commands here    */
      
            };
      
          };
      
      /* for CHARACTERISTIC and AXIS_PTS and MEMORY_LAYOUT */
          "DP_BLOB" struct {
            uint;	/* Address extension of the calibration data 
                         (only Low Byte significant) */
            ulong;	/* Base address of the calibration data */
            ulong;	/* Number of Bytes belonging to the calibration data  */
          };
      
      /* for MEASUREMENT */
          "KP_BLOB" struct {
            uint;	/* Address extension of the online data 
                         (only Low Byte significant) */
            ulong;	/* Base address of the online data   */
            ulong;	/* Number of Bytes belonging to the online data (1,2 or 4) */
            taggedstruct {
               ("RASTER" uchar; )*; 
                      /* Array of event channel initialization values */
             };
          };
      };
      
      /* <-- file ccp_v2_3.aml by ETAS */

      /* --> file etk.aml (15-DEC-1998) by ETAS */
	  /*     patched (10-MAR-1999) by K5/ESQ1-Oc */
      /****************************************************************************/
      /*                                                                          */
      /*   ASAP2 Meta description for ETK                                         */
      /*   - only applicable with ASAP2 V1.3 -                                    */
      /*                                                                          */
      /*   Used data types:                                                       */
      /*                                                                          */
      /*   A2ML       ASAP2          Windows  Explanation                         */
      /*   ---------------------------------------------------------              */
      /*   uchar      UBYTE          BYTE     unsigned 8 Bit                      */
      /*   char       SBYTE          char     signed 8 Bit                        */
      /*   uint       UWORD          WORD     unsigned integer 16 Bit             */
      /*   int        SWORD          int      signed integer 16 Bit               */
      /*   ulong      ULONG          DWORD    unsigned integer 32 Bit             */
      /*   long       SLONG          LONG     signed integer 32 Bit               */
      /*   float      FLOAT32_IEEE            float 32 Bit                        */
      /*                                                                          */
      /****************************************************************************/
      
      /****************************************************************************/
      /*                                                                          */
      /* For a correct working of the ETK, the following MEMORY_SEGMENTs have to  */
      /* be specified in the section 'MOD_PAR' of the ASAP2 file:                 */
      /*																	  	    */
      /*  /begin MEMORY_SEGMENT 													*/
      /*     Dataxxxx ""  DATA FLASH <mem. location> <address> <size> <mirrors>   */
      /*  /end MEMORY_SEGMENT										 			    */ 
      /*																	  	    */
      /*  /begin MEMORY_SEGMENT 													*/
      /*     Codexxxx ""  CODE FLASH <mem. location> <address> <size> <mirrors>   */
      /*  /end MEMORY_SEGMENT										 			    */ 
      /*																	  	    */
      /*  /begin MEMORY_SEGMENT 													*/
      /*     ExRAM "ExRAM for DISTAB" VARIABLES RAM EXTERN <address> <size> <mirrors> */
      /*  /end MEMORY_SEGMENT										 			    */ 
      /*																	  	    */
      /*	Remark: All data included in a hex file, but not specified by a memory  */
      /*          segment will be ignored inside the application program and lost */
      /*          when generating hex file export                                 */
      /*                                                                          */
      /****************************************************************************/
      
      "ETK" taggedstruct
      {
        /* Description of an address mapping between addresses in the view of the EPROM of the ECU  */
        /* (and ASAP2) and the addresses in the scope of the ETK */
        /* IF_DATA section used with MEMORY_SEGMENT (can be missing if no differences between the 2 views) */
        ("ADDRESS_MAPPING" struct
          {
           ulong;  	 /* Start address of MEMORY_SEGMENT   	*/
           ulong;  	 /* mapped start address for ETK   */
           ulong;  	 /* Length of mapped address range    */
		  }  /* PATCH */
          )*;  	 	 /* multiple use of ADDRESS_MAPPING is possible     */
      		 		 /* (even each MEMORY_SEGMENT)			*/
      
        /* Description of the acquisition (trigger) levels supplied by the ECU, 3 is max. no. for ETK */
        (block "SOURCE" struct
          {
            struct
            {
              char [100]; /* Source name */
              int;    /* CSE unit according to Asap1b (minimal period duration) of the */
      		/* acqisition raster*/
              long;   /* Minimal period number measured in the CSE unit */
            };
            taggedstruct
            {
      	/* Description of additional information needed by the ETK device driver */
      	/* to collect the measurement data from a certain acquisition raster */
              "QP_BLOB" struct
              {                                                                
                uint;	/* Acquisition raster 1=A (typ. angle synchronous)               */
                      /*                    2=B (typ. time synchronous 10 msec)        */
                      /*                    3=C (typ. time synchronous 100 msec)       */
                      /*                    4=S/T angle synchronous (bypass only)      */
                      /*                    5=X/Y time synchronous  (bypass only)      */
      		/* Description				  keyword from DAMOS     */
                uint;	/* Max. length of display table in bytes  MAXNUM_A/B/C/BPMAX_S/X  */
                ulong;/* Start address of display table         DISTAB_A/B/C/BYPASS_S/X */
                ulong;/* Output address of display table  	  CHNL_A/B/C/S/X          */
                ulong;/* Address of trigger id                  TRGID_A/B/C/S/X         */
                uint;	/* Repetition rate of trigger             3rd value from DISTAB_A/B/C/S/X */
                uint;	/* Max. size of bypass receive table 	  -/-/-/BPMAX_T/Y         */
                ulong;/* Output address of the bypass table     -/-/-/CHNL_T/Y          */
              };
            };
          })*;  	/* SOURCE can be used several times */
      
        /* Description of additional information needed to configure the ETK device driver */
        /* for measurement and calibration */
        block "TP_BLOB" struct
        {
          ulong;  /* Version number of the TP-Blob; uppermost byte is always != 0, so that */
                  /* informations cannot be mixed up with older blob versions 	*/
                  /* (trigger address was previously at the first position and had max. 24 Bit)*/
                  /* current value: 0x01000001                                    */
      
          ulong;  /* Project base address (offset to be added to every calibration address) PBA */
          ulong;  /* ETKP: RESET_CFG parameter only for PPC family CPU            */
      
          block "DISTAB_CFG" struct {
            uint;    /* Type of display table (13 recommended,           DSPTAB   */
      	           /* 12, 11, 20 only for old projects)                         */
            uint;    /* Data type of display table: 1=byte 2=word        DAT_MOD  */
                     /* additional code table for distab 13 depending 			*/
      			   /* on bus width / bus access 								*/
      			   /* (see distab 13 spec. for more information)                */
            uint;    /* Byte order 1 = high first, 2 = low first  	   RFG      */
            ulong;   /* Trigger segment address                          TRGSEGAD */
            ulong;   /* Trigger configuration  (special code)            TRG_CFG  */
            taggedstruct {
              "TRG_MOD" ( uchar; )*;	 /* Dyn. length for TRG_MOD         */
                                       /* (special code)   		   */
            };
          };
      
          taggedstruct {
      
            /* A check, whether program and data are matching can be performed, if the */
            /* ECU copies a certain 'program identifier' (e.g. the code checksum) into the */
            /* external RAM and the same identifier is stored in the data range. The ETK */
            /* driver can read and compare both identifier and issue an error message, if */
            /* the both identifiers do not match. 				     */
            "CODE_CHK" struct {
              ulong;  /* ETK: address of program identifier in the data range PRG_DATA */
              uint;   /* ETK: length of program identifier in the data range (max. 4 bytes) */
              ulong;  /* ETK: address of program identifier in the external RAM PRG_ERAM */
              uint;   /* ETK: length of program identifier in the external RAM (max. 4 bytes) */
      	/* If all parameters contain 0x0 values, no check is performed */
            };
      
            /* Description of ETK configuration parameters, as configured with the ETK configuration tool */
            "ETK_CFG" ( uchar; )*;	/* ETK_CFG parameters (dyn. length)          */
      
            /* Additional description of data ranges overwriting the MEMORY_SEGMENT description */
            ( "EMU_DATA" struct {
              ulong; 	/* Start address      	    */
              ulong; 	/* Length in bytes	    */
              enum {  /* Memory attribute         */
                "INTERN"  = 0,
                "EXTERN"  = 1
              };
      	    /* Description of offsets to additional data ranges where the contents of this */
      	    /* data range are mirrored */
      		ulong; 	/* Mirror offset 1	    */
      		ulong; 	/* Mirror offset 2	    */
      		ulong; 	/* Mirror offset 3	    */
      		ulong; 	/* Mirror offset 4	    */
      		ulong;  /* Mirror offset 5	    */
      		/* Mirror offsets of -1 indicate that there is no mirror offset */
            })*;
      
            /* Additional description of code ranges overwriting the MEMORY_SEGMENT description */
            ( "EMU_CODE" struct {
              ulong; 	/* Start address      	    */
              ulong; 	/* Length in bytes	    */
              enum {  /* Memory attribute 	    */
                "INTERN"  = 0,
                "EXTERN"  = 1
              };
      		ulong; 	/* Mirror offset 1	    */
      		ulong; 	/* Mirror offset 2	    */
      		ulong; 	/* Mirror offset 3	    */
      		ulong; 	/* Mirror offset 4	    */
      		ulong;  /* Mirror offset 5	    */
            })*;
      
            /* Additional description of external RAM ranges overwriting the MEMORY_SEGMENT */
            /* description */
            ( "EMU_RAM" struct {
              ulong; 	/* Start address      	    */
              ulong; 	/* Length in bytes	    */
              enum {  /* Memory attribute 	    */
                "INTERN"  = 0,
                "EXTERN"  = 1
              };
      		ulong; 	/* Mirror offset 1	    */
      		ulong; 	/* Mirror offset 2	    */
      		ulong; 	/* Mirror offset 3	    */
      		ulong; 	/* Mirror offset 4	    */
      		ulong;  /* Mirror offset 5	    */
            })*;
      
            /* Description of 'reserved ranges' (especially in the data or code ranges; e.g. */
            /* location of the display tables) that are excluded from checksum verification  */	
      	  /* If the 3 display tables stand close together, the size of the reserved memory */
      	  /* is calculated by the following formula:                                       */
      	  /*                                                                               */
      	  /* 	 size = (highest start address of the 3 distabs) 						   */
      	  /* 		  + ((size of this distab) + 2) * 4 								   */
      	  /* 		  - (lowest start address of the 3 distabs)                            */
      	  /*                                                                               */
            ( "RESERVED" struct {
              ulong; 	/* Start address      	    */
              ulong; 	/* Length in bytes	    */
              enum {  /* Memory attribute 	    */
                "INTERN"  = 0,
                "EXTERN"  = 1
              };
      		ulong; 	/* Mirror offset 1	    */
      		ulong; 	/* Mirror offset 2	    */
      		ulong; 	/* Mirror offset 3	    */
      		ulong; 	/* Mirror offset 4	    */
      		ulong;  /* Mirror offset 5	    */
            })*;
      
            /* Description of the ETK mailbox that is used for communication between the ECU and */
      	  /* the application program (e.g. for programming data into the ECU flash) */	
            "ETK_MAILBOX" struct {
              ulong;      /* Test pattern for the ECU to detect a valid mailbox	   */
              enum {      /* Memory page (code, data, external RAM) used for communication */
                          /* from application program to ECU */ 									
                "CODE"  = 1,
                "DATA"  = 2,
                "EXRAM" = 3
              };
              ulong;      /* Base address of buffer for communication appl. program -> ECU  */
              ulong;      /* Length of buffer for comunication appl. program -> ECU   */
              enum {      /* Memory page (code, data, external RAM) used for communication */
                          /* from ECU to application program */ 									
                "CODE"  = 1,
                "DATA"  = 2,
                "EXRAM" = 3
              };
              ulong;      /* Base address of buffer for communication ECU -> appl. program */
              ulong;      /* Length of buffer for comunication ECU -> appl. program  */
            };
          }
        };
        /* for CHARACTERISTIC and AXIS_PTS and MEMORY_LAYOUT */
        "DP_BLOB" struct
        {
          ulong;      /* start address for example of a map */
          ulong;      /* length of the map                  */
        };
      
        /* for MEASUREMENT */
        "KP_BLOB" struct
        {
          ulong;      /* start address of measurement variable */
          uint;       /* address location (0=intern, 1=extern) */
          uint;       /* number ob bytes */
        };
      };
      /* <-- file etk.aml (15-DEC-1998) by ETAS */
/****************************************************************************/
/*                                                                          */
/*   ASAP2-Meta-Beschreibung fr KWP2000 Protokoll                          */
/*   - nur in ASAP V1.2 anwendbar -                                         */
/*                                                                          */
/*   Robert Bosch GmbH K5/ESK3-Schneider                                    */
/*   Stand 0.1, 29.01.97                                                    */
/*   Ergaenzungen:                                                          */
/*   ETAS-Fh 18.06.97: Datentypen teilweise auf unsigned abge„ndert         */
/*                     QP-BLOB abge„ndert: CSE-Einheiten entfernt           */
/*                     TP-BLOB erg„nzt:    SERAM-Adressen                   */
/*                                                                          */
/*   Vector Informatik GmbH - Schnorr 14.8.97:                              */
/*      Syntax korrigiert                                                   */
/*                                                                          */
/*   ETAS-Hn 24.07.98:							    */
/* 	- Neues Schluesselwort 'ADDRESS_MAPPING' im IF_DATA		    */
/*	  'MEMORY_SEGMENT' (optional) 				            */
/*	- Abbildung von SG-Speicherbereichen (aus 			    */
/*	  'MEMORY_SEGMENT') auf die Adressbereiche des ETK, 		    */
/*	  falls eine Umrechnung erforderlich ist. wirkt sich 		    */
/*	  diese auf alle Adressen (MEMORY_SEGMENT, DP-Blob 		    */
/*	  und KP-Blob aus.     		                                    */
/*                                                                          */
/*   ETAS-Hn 27.07.98: 							    */
/*	 Neue Struktur von allen Blobs, Anforderungen der		    */
/*	 Messdatenerfassung und des HVD (incl. ProF)   			    */
/*	 eingearbeitet (Version 1.00)                     		    */
/*                                                                          */
/*                                                                          */
/*   ETAS-Hn 13.04.99: Version 1.01			                    */
/*	 - Projektbasisadresse entfällt, damit im ASAP1b-     		    */
/*	   Treiber keine Adressanpassung für C-DAMOS mehr	            */
/*	   möglich, INCA nimmt Werte aus CALIBRATION_METHOD  		    */
/*	 - Schlüsselwort 'DATA_ACCESS' ersetzt 'SERAM', damit 		    */
/*	   folgen wie oben		                                    */
/*	 - Schlüsselwort 'DIAG_BAUD' ersetzt 'BAUD_DEF', damit  	    */
/*	   Baudratenumschaltung nach VDA-Spezifikation möglich		    */
/* 	 - neues Schlüsselwort 'PAGE_SWITCH' spezifiziert  		    */
/*	   KWP2000-service zur Seitenumschaltung (Escapecode, 		    */
/*	   lokale Routine) sowie deren Parameter. Falls			    */
/*	   'PAGE_SWITCH' fehlt, wird von einem SG ohne Seiten-		    */
/*	    umschaltung ausgegangen					    */
/*                                                                          */
/*   Vector Informatik GmbH - Schnorr 25.2.2000: 			    */
/*			Syntax korrigiert				    */
/*                                                                          */
/*   ETAS-Mkh 28.02.2000 -Korrektur der Semikolon			    */
/*			 -anpassen der Tagged structs im TP-Blob	    */
/*			 -erfolgreicher Check mit IWQ-Parser aus 12/99	    */
/*									    */
/*   Verwendete Datentypen:                                                 */
/*                                                                          */
/*   A2ML       ASAP2          Windows  Erl„uterung                         */
/*   ---------------------------------------------------------              */
/*   uchar      UBYTE          BYTE     unsigned 8 Bit                      */
/*   char       SBYTE          char     signed 8 Bit                        */
/*   uint       UWORD          WORD     unsigned integer 16 Bit             */
/*   int        SWORD          int      signed integer 16 Bit               */
/*   ulong      ULONG          DWORD    unsigned integer 32 Bit             */
/*   long       SLONG          LONG     signed integer 32 Bit               */
/*   float      FLOAT32_IEEE            float 32 Bit                        */
/*                                                                          */
/****************************************************************************/

"ASAP1B_KWP2000"  taggedstruct {

	/* bei MEMORY_SEGMENT (optional)			*/
	("ADDRESS_MAPPING" struct
		{
			ulong;  	 /* Anfangsadresse lt. MEMORY_SEGMENT   	*/
			ulong;  	 /* zu verwendende Anfangsadresse für den ETK   */
			ulong;  	 /* Laenge des umzumappenden Adressbereiches    */
		}
	)*;  	     /* ADDRESS_MAPPING kann mehrfach und für Teilbereiche auftreten */

	/* Beschreibung des Authentifizierungsprozesses */

	( "SEED_KEY" 
		 char[256]    /* name of Seed&Key DLL for application, incl. path and extension */
	)*;

		  (block "SOURCE" struct {

			struct {
			  char [100]; 	/* Name */
			  int;		/* CSE-Einheiten */
			  long;		/* min Periodendauer */
			};
			taggedstruct {
			  "QP_BLOB" struct {
				uint;	          /* No of sampling raster */
				enum {           /* Measurement mode of ECU: Block with */
						  /* local Id or single by address */
				  "ADDRESSMODE"  = 1,
				  "BLOCKMODE"    = 2
				};
				uint;	          /* Block mode: local identifier */
				uint;	          /* max. sampling rate (+ p3min) */
				uint;	          /* max. no of signals  */
				};
			  };
			}
		  )*;

		  block "TP_BLOB" struct {

			uint;	     /* Blob version,  High byte: version             	 */
						 /*                Low byte : sub version (decimal.) */
						 /* starts with 0x0100 */
			uint;		  /* ECU address on k line */
			uint;		  /* required tester address */
			enum {       /* KW INI: stimulation mode of ECU: WuP or 5 baud */
			  "WuP"   = 1,
			  "5Baud" = 2
			};
			enum {      /* byte order in measurements and characteristics */
			  "MSB_FIRST" = 1,
			  "MSB_LAST"  = 2
			};
			uint;		 /* 1: 1st startDiagnosticSession without baudrate switch */

			taggedstruct {

			"DATA_ACCESS" struct {
				ulong;       /* ECU address type qualifier for Flash page */
				ulong;       /* ECU address type qualifier for RAM page */
				uint;        /* 1: Read access on ECU flash data */
				uint;        /* 1: Verify access on ECU flash code */
				uint;        /* 1: Read access on ECU flash code */
				uint;        /* 1: Upload and download only on active page */
			  };

			  block "CHECKSUM" struct {
				ulong;       /* check sum type qualifier (see table) */
				uint;        /* 1: check sum calculation only on active page */
				uint;		 /* No of local routine for check sum */
				enum {       /* result of checksum routine delivered by */
				  "RequestRoutineResults" = 0,
				  "StartRoutine"          = 1,
				  "CodedResult"			  = 2
				};
				taggedstruct {
					"RNC_RESULT" ( uchar )*;	/* only at 'RequestRoutineResults': */
									/* result codes, that sign 'calculation in progress' */
				};
			  };

			  block "FLASH_COPY" struct {
				enum {       /* ECU mode for copying RAM into Flash */
				  "NOFLASHBACK"   = 0x00,
				  "AUTOFLASHBACK" = 0x40,
				  "TOOLFLASHBACK" = 0x80
				  };
				uint;		   /* No of local routine for copy Flash to RAM */
				  enum {       /* result of copy routine delivered by */
				  "RequestRoutineResults" = 0,
				  "StartRoutine"          = 1,
				  "CodedResult"			  = 2
				  };
				enum {       /* ECU mode for copying Flash into RAM */
				  "RAM_InitByECU"  = 0x10,
				  "RAM_InitByTool" = 0x20
				  };
				  uint;        /* diagnostic mode for copy RAM to Flash */
				taggedstruct {
				  "COPY_FRAME" ( uchar )*;	/* list of page frames to be copied */
				  "RNC_RESULT" ( uchar )*;	/* only at 'RequestRoutineResults': */
								/* result codes, that sign 'copy in progress' */
				  "COPY_PARA" ( uchar )*;	/* list of add. parameters for local routine */
				};
			   };        

			  ( block "DIAG_BAUD" struct {		 /* Baudrate switch:       */
				 ulong;			 	 /* BaudRate  */
				 uint;				 /* DiagMode  */
				 taggedstruct {
					"BD_PARA" ( uchar )*;	  /* bytes for ECU baudrate switch */
				 };
			   }
			   )*;

			  ( "TIME_DEF" struct {	 /* Timing parameter:  */
				  uint;				 /* p1Max  */
				  uint;				 /* p2Min  */
				  uint;				 /* p2Max  */
				  uint;				 /* p3Min  */
				  uint;				 /* p3Max  */
				  uint;				 /* p4Min  */
				}
			  )*;


			  ( "SECURITY_ACCESS" struct {	/* Parameter for Seed&Key: */
				  uint; 		/* Access mode for KWP2000 service 27h */
				  uint; 		/* method of seed&key calculation (see table) */
				  uint;		    	/* delaytime in sec from stimulation to seed request */
				}
			  )*;  	

			  block "PAGE_SWITCH" struct {
				enum {       /* ECU mode for switching pages */
				  "ESCAPE_CODE"   = 0x80,
				  "LOCAL_ROUTINE" = 0x31
				  };
				taggedstruct {
					"ESCAPE_CODE_PARA"  ( uchar )*;
					block "ROUTINE_PARA" struct {
						uint;		   /* No of local routine for page switching */
						enum {         /* result of switching routine delivered by */
							"RequestRoutineResults" = 0,
							"StartRoutine"          = 1,
							"CodedResult" 	      = 2
						};
			  			taggedstruct {
						 "RNC_RESULT" ( uchar )*;	/* only at 'RequestRoutineResults': */
										/* result codes, that sign 'switching in progress' */
						};
					}; 
				   	"PAGE_CODE" ( uchar )*;			/* codes for RP and WP */
			 	};
			};
		     };
		  };

		  "DP_BLOB" struct {
			ulong;	/* Start address */
			ulong;	/* Size of characteristic in bytes */
		  };

		  "KP_BLOB" struct {
			ulong;	/* Start address */
			enum {    /* Address location   		   */
			  "INTERN"  = 0,
			  "EXTERN"  = 1
			};
			uint;		/* Size of measurement in bytes */
		  };
		};/******************************************************************************/
/*                                                                            */
/*   ASAP2-Meta-description for MCMESS                                        */
/*   - only for ASAP V1.2 -                                                   */
/*                                                                            */
/*   Schnorr, Vector Informatik GmbH                                          */
/*   Stand 29.August 97                                                       */
/*                                                                            */
/*   Tobias Ostgathe (Og), Etas GmbH & Co.Kg                                  */
/*   Tel.: +49 (711) 89661-354                                                */
/*   Fax.: +49 (711) 89661-107                                                */
/*                                                                            */
/*   ETAS-Og 22.06.99:                                                        */
/*          - Number of signals in QP_BLOB converted to number of             */
/*            bytes according to DAMOS                                        */
/*            /MCK, BLKZ_W x and /MCK BLKZ_Z x                                */
/*          - raster type in QP_BLOB is an enum now                           */
/*          - blob version added in TP_BLOB --> current version 1.1           */
/*          - many parameters in TP_BLOB are optional now                     */
/*          - CHECKSUM_PARAM-block added in TP_BLOB                           */
/*          - DEFINED_PAGES-block added in TP_BLOB                            */
/*          - THREE_BYTE_ADDRESSES flag added                                 */
/*          - COPY_FLASH_TO_RAM_BY_COMMAND flag added                         */
/*          - removed areas                                                   */
/*                                                                            */
/*   used data types:                                                         */
/*                                                                            */
/*   A2ML       ASAP2          Windows  Erläuterung                           */
/*   ---------------------------------------------------------                */
/*   uchar      UBYTE          BYTE     unsigned 8 Bit                        */
/*   char       SBYTE          char     signed 8 Bit                          */
/*   uint       UWORD          WORD     unsigned integer 16 Bit               */
/*   int        SWORD          int      signed integer 16 Bit                 */
/*   ulong      ULONG          DWORD    unsigned integer 32 Bit               */
/*   long       SLONG          LONG     signed integer 32 Bit                 */
/*   float      FLOAT32_IEEE            float 32 Bit                          */
/*                                                                            */
/******************************************************************************/
"ASAP1B_MCMESS" taggedstruct
{
   (block "SOURCE" struct
   {
      struct
      {
         char [100];          /* Name                                         */
         int;                 /* CSE-unit          == 103 | always event      */
         long;                /* min Periodendauer == 1   | triggered         */
      };
      taggedstruct
      {
         "QP_BLOB" struct
         {
            enum              /* type of sampling raster                      */
            {
               "HANDSHAKE" = 0x00,
               "ANGLE"     = 0x08,
               "TIME"      = 0x0C
            };
            uint;             /* max. no of bytes in signal group             */
                              /*  -handshake : 0                              */
                              /*  -angle     : BLKZ_W from DAMOS              */
                              /*  -time      : BLKZ_Z from DAMOS              */
         };
      };
   }
   )*;

   block "TP_BLOB" struct
   {
      uint;                   /* Blob version,                                */
                              /*    High byte: version                        */
                              /*    Low byte : sub version (decimal.)         */
                              /* starts with 0x0101                           */
      taggedstruct
      {
         "KOMKEN"      uint;     /* communication identifier 1..255           */
         "MCTGT"       long;     /* Targetadresse im Steuerger"t              */
         "MCINI"       enum
         {
            "MASSE"  = 0,
            "KW2000" = 1
         };                      /* wake-up type                              */
         "WFSIDLE0"    uint;     /* immobilizer IDLE0                         */
         "WFSIDLE1"    uint;     /* immobilizer IDLE1                         */
         "WFS5B"       uint;     /* immobilizer 5 baud                        */
         "NOOFCYL"     uint;     /* number of cylinders                       */
         "CYLCNAME"    char[20]; /* name of cylindercounter-cell              */
         "CYLSEQU"     char[30]; /* firing order: e.g "1,3,4,2"               */
         "XRAMOF"      uint;     /* EXRAM-Offset: 0..255                      */
      
         block "CHECKSUM_PARAM" struct
         {
            ulong;            /* check sum type qualifier (see table)         */
            taggedstruct
            {
               "CHECKSUM_CALCULATION"
               enum
               {
                  "ACTIVE_PAGE", /* default                                   */
                  "WORKING_PAGE" /* checksum always on working page           */
               }; 
            };
         };

         (block "DEFINED_PAGES" struct
         {
            uint;
            char[101];
            taggedunion
            {
               "RAM" struct /* working page */
               {
                  enum
                  {
                     "RAM_INIT_BY_ECU",  /* RAM is initialized by ECU (default) */
                     "RAM_INIT_BY_TOOL"  /* RAM is initialized by TOOL          */
                  };
                  taggedstruct
                  {
                     "DEFAULT";          /* page is the default page            */
                  };
               };
               "ROM" taggedstruct /* reference page */
               {
                  "DEFAULT";
               };
               "FLASH" struct /* reference page */
               {
                  enum
                  {
                     "NO_FLASH_BACK",
                     "AUTO_FLASH_BACK",  /* ECU will copy ram to flash automatically */
                                         /* after ECU-reset                          */
                     "FLASH_BACK"        /* ECU will copy ram to flash automatically */
                                         /* after ECU-reset if the corresponding     */
                                         /* McMess-command has told the ECU to do so */
                  };
                  taggedstruct
                  {
                     "DEFAULT";
                  };
               };
               "EEPROM" struct /* reference page */
               {
                  enum
                  {
                     "NO_FLASH_BACK",
                     "AUTO_FLASH_BACK",
                     "FLASH_BACK"
                  };
                  taggedstruct
                  {
                     "DEFAULT";
                  };
               };
            };
         })*;
                                 /* byte-order of measurements. Default is the   */
                                 /* value of the Asap2-BYTE_ORDER-section or     */
                                 /* MSB_FIRST if there is none.                  */
         "BYTE_ORDER" enum
         {
            "MSB_FIRST",
            "MSB_LAST"
         };
         "THREE_BYTE_ADDRESSES"; /* specifies if the ECU supports 3-byte         */
                                 /* addresses with McMess                        */
         "COPY_FLASH_TO_RAM_BY_COMMAND";/* specifies if the ECU supports the     */
                                        /* McMess - copy flash to ram command    */
      };
   };/*TP_BLOB*/


   block "KP_BLOB" struct
   {
      long;                   /* address                                      */
      enum                    /* address location                             */
      {
         "INTERN",
         "EXTERN"
      };
      uint;                   /* size of measurement in bytes                 */
      taggedstruct
      {
         "PSEUDO_ADR" uint;     /* pseudoadress 1..255                        */
         "VS_DEF"     char[20]; /* name of calibration parameter, default ""  */
      };
   };

   "DP_BLOB" struct
   {
      ulong;                  /* Start address                                */
      ulong;                  /* Size of characteristic in bytes              */
   };
};

    }; 
  /end A2ML

  /begin MOD_PAR "B_EDC16"
    VERSION "XXX"
    CUSTOMER_NO "999"
    USER "X"
    PHONE_NO "X"
    CPU_TYPE "GoldenOak"
    ECU "GrO"
    /begin MEMORY_SEGMENT Pst8000 "" CODE FLASH INTERN 0x8000 0xB8000 -1 -1 -1 -1 -1 
        /* AsapMLCFm - CCP_V2_3 */
        
        /begin IF_DATA ETK 
            ADDRESS_MAPPING 
                /* origin addr  */ 0x8000 
                /* mapping addr */ 0x8000 
                /* length       */ 0xB8000 
        /end IF_DATA 
        
        /* AsapMLCFm - KWP2000 */ 
        
        /* AsapMLCFm - McMess */ 
    /end MEMORY_SEGMENT

    /begin MEMORY_SEGMENT Pst400000 "" CODE FLASH INTERN 0x400000 0x80000 -1 -1 -1 -1 -1 
        /* AsapMLCFm - CCP_V2_3 */
        
        /begin IF_DATA ETK 
            ADDRESS_MAPPING 
                /* origin addr  */ 0x400000 
                /* mapping addr */ 0x400000 
                /* length       */ 0x80000 
        /end IF_DATA 
        
        /* AsapMLCFm - KWP2000 */ 
        
        /* AsapMLCFm - McMess */ 
    /end MEMORY_SEGMENT

    /begin MEMORY_SEGMENT DstC0000 "" DATA FLASH INTERN 0xC0000 0x3DF78 -1 -1 -1 -1 -1 
        /* AsapMLCFm - CCP_V2_3 */
        
        /begin IF_DATA ETK 
            ADDRESS_MAPPING 
                /* origin addr  */ 0xC0000 
                /* mapping addr */ 0x8C0000 
                /* length       */ 0x3DF78 
        /end IF_DATA 
        
        /* AsapMLCFm - KWP2000 */ 
        
        /* AsapMLCFm - McMess */ 
    /end MEMORY_SEGMENT

    /begin MEMORY_SEGMENT DstFDF78 "" RESERVED FLASH INTERN 0xFDF78 0x88 -1 -1 -1 -1 -1 
        /* AsapMLCFm - CCP_V2_3 */
        
        /begin IF_DATA ETK 
            ADDRESS_MAPPING 
                /* origin addr  */ 0xFDF78 
                /* mapping addr */ 0x8FDF78 
                /* length       */ 0x88 
        /end IF_DATA 
        
        /* AsapMLCFm - KWP2000 */ 
        
        /* AsapMLCFm - McMess */ 
    /end MEMORY_SEGMENT

    /begin MEMORY_SEGMENT ExtRam8FE000 "" VARIABLES RAM EXTERN 0x8FE000 0x2000 -1 -1 -1 -1 -1 
        /* AsapMLXFm - CCP_V2_3 */
        
        /begin IF_DATA ETK 
            ADDRESS_MAPPING 
                /* origin addr  */ 0x8FE000 
                /* mapping addr */ 0x8FE000 
                /* length       */ 0x2000 
        /end IF_DATA 
        
        /* AsapMLXFm - KWP2000 */ 
        
        /* AsapMLXFm - McMess */ 
    /end MEMORY_SEGMENT

    /begin MEMORY_SEGMENT Ram7F8000 "" VARIABLES RAM INTERN 0x7F8000 0x8000 -1 -1 -1 -1 -1 
    /end MEMORY_SEGMENT

    /begin MEMORY_SEGMENT Ram6F8000 "" VARIABLES RAM INTERN 0x6F8000 0x800 -1 -1 -1 -1 -1 
    /end MEMORY_SEGMENT

    /begin MEMORY_SEGMENT Ram800000 "" VARIABLES RAM INTERN 0x800000 0x8000 -1 -1 -1 -1 -1 
    /end MEMORY_SEGMENT



    SYSTEM_CONSTANT "ACCD_PANALIN_CUR_X" "2"
    SYSTEM_CONSTANT "ACCD_PPRESLIN_CUR_X" "2"
    SYSTEM_CONSTANT "ACCD_PRESSEL_ANALOG" "1"
    SYSTEM_CONSTANT "ACCD_PRESSEL_PWM" "2"
    SYSTEM_CONSTANT "ACCD_SWTPRESSEL_TYPE" "2"
    SYSTEM_CONSTANT "ACCD_SWTPRESSEL_VAL" "2"
    SYSTEM_CONSTANT "ACCD_SWTSIG_TYPE" "2"
    SYSTEM_CONSTANT "ACCD_SWTSIG_VAL" "0"
    SYSTEM_CONSTANT "ACCPED_NERR_CUR_X" "2"
    SYSTEM_CONSTANT "ACCPED_RFDC_CUR_X" "16"
    SYSTEM_CONSTANT "ACCPED_TRQENG_MAP_X" "16"
    SYSTEM_CONSTANT "ACCPED_TRQENG_MAP_Y" "10"
    SYSTEM_CONSTANT "ACCPED_TRQPRP_MAP_X" "2"
    SYSTEM_CONSTANT "ACCPED_TRQPRP_MAP_Y" "2"
    SYSTEM_CONSTANT "ACC_MAX" "10"
    SYSTEM_CONSTANT "ACC_NORM_FAC" "2777777.77777778"
    SYSTEM_CONSTANT "ACC_RES" "0.001"
    SYSTEM_CONSTANT "ACC_TRQREDSHFT_CUR_X" "7"
    SYSTEM_CONSTANT "ACC_ZERO" "0"
    SYSTEM_CONSTANT "ACTRQC_TRQAC_CUR_X" "16"
    SYSTEM_CONSTANT "ADC_RES" "1023"
    SYSTEM_CONSTANT "ADDPMP_SWTSERVICE_TYPE" "2"
    SYSTEM_CONSTANT "ADDPMP_SWTSERVICE_VAL" "0"
    SYSTEM_CONSTANT "ADDPMP_VOLADDDEM_CUR_X" "2"
    SYSTEM_CONSTANT "AFSCD_DMAIRSUBSVAL_MAP_X" "16"
    SYSTEM_CONSTANT "AFSCD_DMAIRSUBSVAL_MAP_Y" "16"
    SYSTEM_CONSTANT "AFSCD_DMLINHFM6_CUR_X" "57"
    SYSTEM_CONSTANT "AFSCD_DOUBLE" "2"
    SYSTEM_CONSTANT "AFSCD_FACCOREXT_CUR_X" "3"
    SYSTEM_CONSTANT "AFSCD_PLSCOR_MAP_X" "2"
    SYSTEM_CONSTANT "AFSCD_PLSCOR_MAP_Y" "2"
    SYSTEM_CONSTANT "AFSCD_QAIRMTHRSRCHIACTV_CUR_X" "14"
    SYSTEM_CONSTANT "AFSCD_QWINLDADJHI_CUR_X" "4"
    SYSTEM_CONSTANT "AFSCD_QWINLDADJLO_CUR_X" "5"
    SYSTEM_CONSTANT "AFSCD_SENSSEL_SWT" "1"
    SYSTEM_CONSTANT "AFSCD_SINGLE" "1"
    SYSTEM_CONSTANT "AFSCD_SWTAIRSYS_TYPE" "0"
    SYSTEM_CONSTANT "AFSCD_SWTAIRSYS_VAL" "1"
    SYSTEM_CONSTANT "AFSCD_SWTHFM5" "0"
    SYSTEM_CONSTANT "AFSCD_SWTHFM6" "1"
    SYSTEM_CONSTANT "AFSCD_SWTSENSINST_TYPE" "2"
    SYSTEM_CONSTANT "AFSCD_SWTSENSINST_VAL" "1"
    SYSTEM_CONSTANT "AFSCD_SWTSENSSEL_TYPE" "0"
    SYSTEM_CONSTANT "AFSCD_SWTSENSSEL_VAL" "1"
    SYSTEM_CONSTANT "AFSCD_SWTSENS_INST" "1"
    SYSTEM_CONSTANT "AFSCD_SWTSENS_NOTINST" "0"
    SYSTEM_CONSTANT "AFSCD_SWT_HFM5" "0"
    SYSTEM_CONSTANT "AFSCD_SWT_HFM6" "1"
    SYSTEM_CONSTANT "AFSCD_TLIN_CUR_X" "11"
    SYSTEM_CONSTANT "AFS_FACDYNCORR1_CUR_X" "7"
    SYSTEM_CONSTANT "AFS_FACNENGDYN_MAP_X" "7"
    SYSTEM_CONSTANT "AFS_FACNENGDYN_MAP_Y" "7"
    SYSTEM_CONSTANT "AFS_FACVEHSPD_MAP_X" "3"
    SYSTEM_CONSTANT "AFS_FACVEHSPD_MAP_Y" "3"
    SYSTEM_CONSTANT "AFS_TRQBASEDYN_MAP_X" "7"
    SYSTEM_CONSTANT "AFS_TRQBASEDYN_MAP_Y" "7"
    SYSTEM_CONSTANT "AFS_TRQBASESTATE_MAP_X" "9"
    SYSTEM_CONSTANT "AFS_TRQBASESTATE_MAP_Y" "7"
    SYSTEM_CONSTANT "AFS_TRQDISABLE_MAP_X" "2"
