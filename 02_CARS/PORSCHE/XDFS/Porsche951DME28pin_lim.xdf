	040010 Desc             ="OverBoost MAP.  This is the (calculated) boost curve that the dme looks at to determine overboost.  If boost is above this, then the DME will cut fuel (overboost).  Raise this number to allow for more boost.\r\n"
	040100 Address          =0x6EE
	040200 ZEq              =(X/104)*14.5-14.7,TH|0|0|0|0|
	040203 XOutType         =0x4
