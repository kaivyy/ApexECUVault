  /* --- AgI-Objekt f¸r CCP (ASAP V1.21), Stand 1.0 31.7.98 --- */
  /begin IF_DATA ASAP1B_CCP
      /begin SOURCE
	      "time synchronous event channel - 10 ms"
		  4
		  1
		  /begin QP_BLOB
		      0
			  LENGTH 7
			  CAN_ID_FIXED 0x7A0
			  RASTER 0
		  /end QP_BLOB
	  /end SOURCE
  
      /begin SOURCE
	      "time synchronous event channel - 100 ms"
		  5
		  1
		  /begin QP_BLOB
		      1
			  LENGTH 10
			  CAN_ID_FIXED 0x7A1
			  RASTER 1
		  /end QP_BLOB
	  /end SOURCE
  
      /begin SOURCE
	      "segment synchronous event channel"
		  103
		  1
		  /begin QP_BLOB
		      2
			  LENGTH 2
			  CAN_ID_FIXED 0x7A2
			  RASTER 2
		  /end QP_BLOB
	  /end SOURCE
  
      /begin RASTER
	      "time synchronous event channel - 10 ms"
	      "10_ms"
		  0
		  4
		  1
	  /end RASTER
  
      /begin RASTER
	      "time synchronous event channel - 100 ms"
	      "100_ms"
		  1
		  5
		  1
	  /end RASTER
  
      /begin RASTER
	      "segment synchronous event channel"
	      "seg_sync"
		  2
		  103
		  1
	  /end RASTER
  
	  /begin SEED_KEY
	      /* seed&key dll for CAL privilege */ ""
	      /* seed&key dll for DAQ privilege */ ""
	      /* seed&key dll for PGM privilege */ ""
	  /end SEED_KEY
  
	  /begin TP_BLOB
	      /* CCP version       */ 0x201
		  /* Blob version      */ 0x202
		  /* CAN msg ID - send */ 0x7BC
		  /* CAN msg ID - recv */ 0x7BD
		  /* station address   */ 0x12ED
		  /* byte order        */ 1
          
		  /begin CAN_PARAM
		      /* crystal frequency */ 0x1F4
			  /* timing register 0 */ 0x41
			  /* timing register 1 */ 0x25
		  /end CAN_PARAM
          
		  DAQ_MODE    BURST
		  CONSISTENCY ODT
		  ADDRESS_EXTENSION ODT
		  
	      /begin CHECKSUM_PARAM 
		  	  /* algorithm */ 0xC001
		      /* limit     */ 0xFFFFFFFF
		      CHECKSUM_CALCULATION ACTIVE_PAGE
		  /end CHECKSUM_PARAM 
          
		  /begin DEFINED_PAGES
		      1
			  "reference page"
			  /* address ext. */ 0x1
			  /* base address */ 0x1C0000
			  /* page length  */ 0x1FFFF
			  ROM
		  /end DEFINED_PAGES
          
		  OPTIONAL_CMD 0xC  /* SELECT_CAL_PAGE */
		  OPTIONAL_CMD 0xD  /* BUILD_CHKSUM */
		  OPTIONAL_CMD 0xE  /* MOVE */
		  OPTIONAL_CMD 0x11  /* GET_ACTIVE_CAL_PAGE */
		  OPTIONAL_CMD 0x19  /* SET_S_STATUS */
		  OPTIONAL_CMD 0xD  /* GET_S_STATUS */
		  OPTIONAL_CMD 0x12  /* GET_SEED */
		  OPTIONAL_CMD 0x13  /* UNLOCK */
	  /end TP_BLOB
  /end IF_DATA

  /* --- Default-AgI-Objekt  */
  /* --- AgI-Objekt f¸r ETK (ASAP V1.3B0), Stand 1.0 16.7.98 --- */
  /begin IF_DATA ETK
    /begin TP_BLOB   /*version:*/0x1000001  /*pba:*/0x0  /*reset_cfg:*/0x40001800
      /begin DISTAB_CFG   /*dsptab:*/0xD   /*dat_mod:*/0x1   /*rfg:*/0x1   /*trgsegad:*/0x5E0000   /*trg_cfg:*/0x1020100 
        TRG_MOD /*Id:*/ 0x0   /*trg_mod:*/0xFF 0x0 0x0 0x0 
      /end DISTAB_CFG       CODE_CHK   /*prg_data:*/0x5C0210   /*prg_length:*/0xC   /*prg_eram:*/0x5E01DC   /*prg_length:*/0xC 
      ETK_CFG  0x2 0xc2 0x3d 0xff 0xef 0x3e 0xdf 0xef 0x3d 0xff 0xfb 0xfe 0xff 0xff 0xfe 0xff 0xff 0xff 0xff 0xff 0x3 0x60 0x5 0xff
 /*   EMU_RAM  start_addr  length   CS     offset >>>>>   (multiple)  */
 /*   EMU_DATA start_addr  length   CS     offset >>>>>   (multiple)  */
 /*   EMU_CODE start_addr  length   CS     offset >>>>>   (multiple)  */
 /*   RESERVED start_addr  length   CS     offset >>>>>   (multiple)  */
