    SYSTEM_CONSTANT "AIRCTL_DKDNEGQDES_MAP_Y" "8"
    SYSTEM_CONSTANT "AIRCTL_DKDNEGRGN_MAP_X" "8"
    SYSTEM_CONSTANT "AIRCTL_DKDNEGRGN_MAP_Y" "8"
    SYSTEM_CONSTANT "AIRCTL_DKDPOSAGR_MAP_X" "8"
    SYSTEM_CONSTANT "AIRCTL_DKDPOSAGR_MAP_Y" "8"
    SYSTEM_CONSTANT "AIRCTL_DKDPOSQDES_MAP_X" "8"
    SYSTEM_CONSTANT "AIRCTL_DKDPOSQDES_MAP_Y" "8"
    SYSTEM_CONSTANT "AIRCTL_DKDPOSRGN_MAP_X" "8"
