  <XDFCONSTANT uniqueid="0x432F">
    <title>Raw MAF Patch Bytes</title>
    <description>80008001 will show PROMID in bytes 1 and 2 of the mode 0 message 1 datastream. changing to 00B500B6 will allow logging of target AFR using the equation 65536/[40*(MSB*256+LSB)]. 00D700D8 should give raw MAF pulse info.</description>
    <EMBEDDEDDATA mmedaddress="0x1324" mmedelementsizebits="32" />
    <outputtype>3</outputtype>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x5281">
    <title>Injector Constant</title>
    <EMBEDDEDDATA mmedaddress="0xB85" mmedelementsizebits="16" />
    <units>Lb/Hr</units>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="(20480.000000/X + 0.000000)*7.93664144 ">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0x6D69">
    <title>I/P Pulse Divisor</title>
    <description>divide by = decimal value&#013;&#010;&#013;&#010;1 = 0&#013;&#010;6 = 128&#013;&#010;7 = 64&#013;&#010;8 = 192&#013;&#010;9 = 32&#013;&#010;10 = 160&#013;&#010;11 = 96&#013;&#010;&#013;&#010;may be off.... I/P should see 4K PPM</description>
    <EMBEDDEDDATA mmedaddress="0x1795" mmedelementsizebits="8" />
    <outputtype>2</outputtype>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
