    "Readiness Status für Diagnoseschnittstelle gemäß SAE J1979 PID1 Byte C * D"
    UWORD
    OneToOne
    1
    100
    0.00
    65535.00

    
    FORMAT "%8.2"
    
    ECU_ADDRESS 0x7F8BB0
    /begin IF_DATA ASAP1B_CCP
	    KP_BLOB
		  0x00
		  0x7F8BB0
		  0x2
    /end IF_DATA
    /begin IF_DATA ETK 
	    KP_BLOB 
		  0x7F8BB0 
          0 
		  0x2 
    /end IF_DATA 
    /begin IF_DATA ASAP1B_KWP2000 
	    KP_BLOB 
		  0x7F8BB0 
          INTERN 
		  0x2 
    /end IF_DATA 
    /begin IF_DATA ASAP1B_MCMESS 
	    /begin KP_BLOB 
		  0x7F8BB0 
          INTERN 
		  0x2 
	    /end KP_BLOB 
    /end IF_DATA 

/end MEASUREMENT

