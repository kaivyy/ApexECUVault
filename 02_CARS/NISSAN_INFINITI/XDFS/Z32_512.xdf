	000101 Cat1ID           =0x7
	020005 Title            ="Electric Fan - Speed Threshold (AC off)"
	020011 DescSize         =0x302
	020010 Desc             ="Fan activate on speed limit (when AC off)\r\n------------------NA\r\nA/C off, coolant temp below 219 = fan off \r\nA/C off, coolant temp above 221 = fan on \r\nA/C on, vehicle speed < 24mph, coolant below 201 = fan off \r\nA/C on, vehicle speed < 24mph, coolant above 203 = fan on \r\nA/C on, vehicle speed > 25mph, coolant below 219 = fan off \r\nA/C on, vehicle speed > 25mph, coolant above 221 = fan on \r\n\r\nTT\r\n------------------\r\nA/C off, coolant temp below 219 = fan off \r\nA/C off, coolant temp above 221 = fan on \r\nA/C on, vehicle speed < 24 mph, coolant between 194-210 fan = low speed \r\nA/C on, vehicle speed < 24 mph, coolant above 212, fan = high speed \r\nA/C on, vehicle speed > 25mph, coolant below 219 = fan off \r\nA/C on, vehicle speed > 25mph, coolant above 221 = fan on"
	020020 Units            ="MPH"
	020100 Address          =0xFF75
	020200 Equation         =(X-50)/2*0.621371,TH|0|0|0|0|
	020205 OutType          =0x2
%%END%%

