      <LABEL index="0" value="0000" />
      <LABEL index="1" value="0001" />
      <LABEL index="2" value="0010" />
      <LABEL index="3" value="0011" />
      <LABEL index="4" value="0100" />
      <LABEL index="5" value="0101" />
      <LABEL index="6" value="0110" />
      <LABEL index="7" value="0111" />
