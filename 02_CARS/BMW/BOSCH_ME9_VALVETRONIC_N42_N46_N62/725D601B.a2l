    BYTE_ORDER MSB_FIRST
    ALIGNMENT_BYTE 1
    ALIGNMENT_WORD 2
    ALIGNMENT_LONG 2
    ALIGNMENT_FLOAT32_IEEE 4
  /end MOD_COMMON

  /* --- AgI-Objekt f¸r CCP (ASAP V1.21), Stand 1.0 31.7.98 --- */
  /begin IF_DATA ASAP1B_CCP
      /begin SOURCE
	      "time synchronous event channel - 10 ms"
		  4
		  1
		  /begin QP_BLOB
		      0
			  LENGTH 5
			  CAN_ID_FIXED 0x7A0
			  RASTER 0
		  /end QP_BLOB
	  /end SOURCE
  
      /begin SOURCE
	      "time synchronous event channel - 100 ms"
		  5
		  1
		  /begin QP_BLOB
		      1
			  LENGTH 10
			  CAN_ID_FIXED 0x7A1
			  RASTER 1
		  /end QP_BLOB
	  /end SOURCE
  
      /begin SOURCE
	      "segment synchronous event channel"
		  103
		  1
		  /begin QP_BLOB
		      2
			  LENGTH 2
			  CAN_ID_FIXED 0x7A2
			  RASTER 2
		  /end QP_BLOB
	  /end SOURCE
  
      /begin RASTER
	      "time synchronous event channel - 10 ms"
	      "10_ms"
		  0
		  4
		  1
	  /end RASTER
  
      /begin RASTER
	      "time synchronous event channel - 100 ms"
	      "100_ms"
		  1
		  5
		  1
	  /end RASTER
  
      /begin RASTER
	      "segment synchronous event channel"
	      "seg_sync"
		  2
		  103
		  1
	  /end RASTER
  
	  /begin SEED_KEY
	      /* seed&key dll for CAL privilege */ ""
	      /* seed&key dll for DAQ privilege */ ""
	      /* seed&key dll for PGM privilege */ ""
	  /end SEED_KEY
  
	  /begin TP_BLOB
	      /* CCP version       */ 0x201
		  /* Blob version      */ 0x202
		  /* CAN msg ID - send */ 0x7BC
		  /* CAN msg ID - recv */ 0x7BD
		  /* station address   */ 0x12ED
		  /* byte order        */ 1
          
		  /begin CAN_PARAM
		      /* crystal frequency */ 0x1F4
			  /* timing register 0 */ 0x41
			  /* timing register 1 */ 0x25
		  /end CAN_PARAM
          
		  DAQ_MODE    BURST
		  CONSISTENCY ODT
		  ADDRESS_EXTENSION ODT
		  
	      /begin CHECKSUM_PARAM 
		  	  /* algorithm */ 0xC001
		      /* limit     */ 0xFFFFFFFF
		      CHECKSUM_CALCULATION ACTIVE_PAGE
		  /end CHECKSUM_PARAM 
          
		  /begin DEFINED_PAGES
		      1
			  "reference page"
			  /* address ext. */ 0x1
			  /* base address */ 0x1C0000
			  /* page length  */ 0x1FFFF
			  ROM
		  /end DEFINED_PAGES
          
		  OPTIONAL_CMD 0xC  /* SELECT_CAL_PAGE */
		  OPTIONAL_CMD 0xD  /* BUILD_CHKSUM */
		  OPTIONAL_CMD 0xE  /* MOVE */
		  OPTIONAL_CMD 0x11  /* GET_ACTIVE_CAL_PAGE */
		  OPTIONAL_CMD 0x19  /* SET_S_STATUS */
		  OPTIONAL_CMD 0xD  /* GET_S_STATUS */
		  OPTIONAL_CMD 0x12  /* GET_SEED */
		  OPTIONAL_CMD 0x13  /* UNLOCK */
	  /end TP_BLOB
  /end IF_DATA

  /* --- Default-AgI-Objekt  */
  /* --- AgI-Objekt f¸r ETK (ASAP V1.3B0), Stand 1.0 16.7.98 --- */
  /begin IF_DATA ETK
    /begin TP_BLOB   /*version:*/0x1000001  /*pba:*/0x0  /*reset_cfg:*/0x40001800
      /begin DISTAB_CFG   /*dsptab:*/0xD   /*dat_mod:*/0x1   /*rfg:*/0x1   /*trgsegad:*/0x5E0000   /*trg_cfg:*/0x1020100 
        TRG_MOD /*Id:*/ 0x0   /*trg_mod:*/0xFF 0x0 0x0 0x0 
      /end DISTAB_CFG       CODE_CHK   /*prg_data:*/0x5C0210   /*prg_length:*/0xC   /*prg_eram:*/0x5E01DC   /*prg_length:*/0xC 
      ETK_CFG  0x2 0xc2 0x3d 0xff 0xef 0x3e 0xdf 0xef 0x3d 0xff 0xfb 0xfe 0xff 0xff 0xfe 0xff 0xff 0xff 0xff 0xff 0x3 0x60 0x5 0xff
 /*   EMU_RAM  start_addr  length   CS     offset >>>>>   (multiple)  */
 /*   EMU_DATA start_addr  length   CS     offset >>>>>   (multiple)  */
 /*   EMU_CODE start_addr  length   CS     offset >>>>>   (multiple)  */
 /*   RESERVED start_addr  length   CS     offset >>>>>   (multiple)  */
      RESERVED   /*start_addr:*/0x5C0250   /*length:*/0x618   EXTERN -1 -1 -1 -1 -1 

      ETK_MAILBOX  /*pattern:*/0x55555555  /*page_ecu:*/DATA  /*ecu_adr:*/0x560000  /*..length:*/0x8000  /*page_am:*/EXRAM  /*am_adr:*/0x5E1000  /*..length:*/0x7000 
    /end TP_BLOB 
      /begin SOURCE "Synchro" 103 1 
        QP_BLOB  /*raster:*/ 1  /*maxnum:*/0x38  /*distab:*/0x5C0250  /*chnl:*/0x5E0094  /*trgid:*/0x5E0080  /*repet:*/0  /*bypass_max:*/0  /*bypass_out:*/0 
      /end SOURCE 

      /begin SOURCE "10ms" 4 1 
        QP_BLOB  /*raster:*/ 2  /*maxnum:*/0x58  /*distab:*/0x5C0338  /*chnl:*/0x5E00CC  /*trgid:*/0x5E0084  /*repet:*/10 
 /*bypass_max:*/0  /*bypass_out:*/0       /end SOURCE 

      /begin SOURCE "100ms" 5 1 
        QP_BLOB  /*raster:*/ 3  /*maxnum:*/0x58  /*distab:*/0x5C04A0  /*chnl:*/0x5E0124  /*trgid:*/0x5E0088  /*repet:*/100 
 /*bypass_max:*/0  /*bypass_out:*/0       /end SOURCE 

      /begin SOURCE "Bypass_Synchro" 103 1 
        QP_BLOB  /*raster:*/ 4  /*maxnum:*/0x30  /*distab:*/0x5C0608  /*chnl:*/0x5E017C  /*trgid:*/0x5E008C  /*repet:*/0 
 /*bypass_max:*/0x30  /*bypass_out:*/0x5C0798       /end SOURCE 

      /begin SOURCE "Bypass_10ms" 4 1 
        QP_BLOB  /*raster:*/ 5  /*maxnum:*/0x30  /*distab:*/0x5C06D0  /*chnl:*/0x5E01AC  /*trgid:*/0x5E0090  /*repet:*/10 
 /*bypass_max:*/0x30  /*bypass_out:*/0x5C0800       /end SOURCE 

  /end IF_DATA

  /begin IF_DATA ASAP1B_KWP2000 
      /begin SOURCE 
	      "timeslot" 
		  0 
		  0 
		  QP_BLOB 
		      0 
			  BLOCKMODE 
			  0xF0 
			  0 
              20 
	  /end SOURCE 
  
	  /begin TP_BLOB 
		  /* Blob version          */ 0x100 
