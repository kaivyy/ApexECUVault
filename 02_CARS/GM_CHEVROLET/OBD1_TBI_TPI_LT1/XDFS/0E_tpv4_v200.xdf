	000004 VisLevel         =0xA
	000100 Cat0ID           =0x1
	030005 Title            ="180 Degree Offset"
	030011 DescSize         =0xBD
	030010 Desc             ="Title: 180 Degree Offset\r\n\r\nLocation: 400B-Bit 5\r\n\r\nUsage: Air Fuel Mode Words \r\n\r\nTips: Checkmark to enable 180 Degree Offset. I4 bins are normally on. V6 and V8 bins are normally off. \r\n"
	030100 Address          =0x400B
	030200 BitNumber        =0x5
%%END%%

%%FLAG%%
	000002 UniqueID         =0x2C9
	000004 VisLevel         =0xA
	000100 Cat0ID           =0x1
	030005 Title            ="ASDF Crank"
	030011 DescSize         =0xD3
	030010 Desc             ="Title: (Alternate Synchronous Double Fire) ASDF Crank\r\n\r\nLocation: 400B-Bit 4\r\n\r\nUsage: Air Fuel Mode Words \r\n\r\nTips: Checkmark to enable ASDF Crank. I4 bins are normally on. V6 and V8 bins are normally off. \r\n"
	030100 Address          =0x400B
	030200 BitNumber        =0x4
%%END%%

%%FLAG%%
	000002 UniqueID         =0x472D
	000004 VisLevel         =0xA
	000100 Cat0ID           =0x1
	000101 Cat1ID           =0xE
	030005 Title            ="Acceleration Enrichment Limit Option"
	030011 DescSize         =0x11C
	030010 Desc             ="Title: Acceleration Enrichment Limit Option\r\n\r\nLocation: 400B-Bit 3\r\n\r\nUsage: Air Fuel Mode Words \r\n\r\nTips: Limits closed loop corrections when AE is in effect. Checkmark to enable the Acceleration Enrichment Limit Option. V6 bins are normally off. I4 and V8 bins are normally on. \r\n"
	030100 Address          =0x400B
	030200 BitNumber        =0x3
%%END%%

%%FLAG%%
	000002 UniqueID         =0x6AB
	000004 VisLevel         =0x1
	000100 Cat0ID           =0x1
	000101 Cat1ID           =0x7
	030005 Title            ="Synchronous Fuel At Idle"
	030011 DescSize         =0x9E
	030010 Desc             ="Title: Synchronous Fuel At Idle\r\n\r\nLocation: 400B-Bit 2\r\n\r\nUsage: Air Fuel Mode Words   \r\n\r\nTips: Checkmark to enable Synchronous Fuel At Idle. TBI only.  \r\n"
	030100 Address          =0x400B
	030200 BitNumber        =0x2
%%END%%

%%FLAG%%
	000002 UniqueID         =0x1A02
	000004 VisLevel         =0x1
	000100 Cat0ID           =0x1
	000101 Cat1ID           =0xA
	030005 Title            ="AIR Management"
	030011 DescSize         =0xC1
	030010 Desc             ="Title: AIR Management\r\n\r\nLocation: 400B-Bit 1\r\n\r\nUsage: Air Fuel Mode Words \r\n\r\nTips: Enables PCM A.I.R. control. Checkmark if you have a computer controlled Air Injection System (smog pump). "
	030100 Address          =0x400B
	030200 BitNumber        =0x1
%%END%%

%%FLAG%%
	000002 UniqueID         =0x295
	000004 VisLevel         =0xA
	000100 Cat0ID           =0x1
	030005 Title            ="CPI/PFI Mode"
	030011 DescSize         =0x170
	030010 Desc             ="Title: CPI/PFI Mode\r\n\r\nLocation: 400B-Bit 0\r\n\r\nUsage: Air Fuel Mode Words \r\n\r\nTips: To change between TBI and CPI/PFI injector firing strategies. Checkmark if you will be using Central Port Injection or Port Fuel Injection. TBI fires the injectors twice per crankshaft revolution. CPI/PFI fires the injectors once per revolution. PCM modifications are also required. "
	030100 Address          =0x400B
	030200 BitNumber        =0x0
%%END%%

%%FLAG%%
	000002 UniqueID         =0x4EE1
	000004 VisLevel         =0x1
	000100 Cat0ID           =0x1
	000101 Cat1ID           =0x3
	030005 Title            ="Charcoal Canister Purge"
	030011 DescSize         =0xBB
	030010 Desc             ="Title: Charcoal Canister Purge\r\n\r\nLocation: 400C-Bit 7\r\n\r\nUsage: Air Fuel Mode Words \r\n\r\nTips: Enables PCM CCP control. Checkmark if you will be using a computer controlled CCP valve. \r\n"
	030100 Address          =0x400C
	030200 BitNumber        =0x7
%%END%%

%%FLAG%%
	000002 UniqueID         =0x75
	000004 VisLevel         =0xA
	000100 Cat0ID           =0x1
	000101 Cat1ID           =0xC
	030005 Title            ="Conditional Integrator Reset on BLM Cell Change"
	030011 DescSize         =0x12F
	030010 Desc             ="Title: Conditional Integrator Reset on BLM Cell Change\r\n\r\nLocation: 400C-Bit 6\r\n\r\nUsage: Air Fuel Mode Words \r\n\r\nTips: To have the integrator reset when a BLM cell change occurs. This mode is not used with 400C-Bit 4, but is used with 400C-Bit 5. Used on I4 engines, not used on V6 or V8 engines.    \r\n"
	030100 Address          =0x400C
	030200 BitNumber        =0x6
%%END%%

