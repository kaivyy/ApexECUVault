    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0xE00D" flags="0x0">
    <title>ALS Capture Grip Angle (WOT)</title>
    <description>With START held and rolling, when grip (0xFEF025EC, ~107 deg = full) reaches this the current RPM is captured. Default 90. @0xBF004</description>
    <CATEGORYMEM index="0" category="38" />
    <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0xBF004" mmedelementsizebits="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
