	001000 FileVers         =""
	001005 DefTitle         ="92 Porsche C2"
	001007 DescSize         =0x14C
	001006 Desc             ="This XDF is for the 1992 Porsche 911 C2 it is for the 32K (27c256) UV  EProm chip that was used for the 92 cars. This XDF works with following chips: 1267357006, 1267357245 (RS Chip) may work with others as well but will not work with early C2 chips as the early chips have diffrent map table and the maps are in diffrent locations."
	001010 Author           ="Sal Carceller"
	001030 BinSize          =0x8000
	001035 BaseOffset       =0
	001200 ADSAssoc         =""
