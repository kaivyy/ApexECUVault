%%TABLE%%
	000002 UniqueID         =0x71EC
	000100 Cat0ID           =0x6
	040005 Title            ="T_AFMTransferMap"
	040011 DescSize         =0x15F
	040010 Desc             ="This map is the AirFlowMeter (AFM) transfer map located at 0x00F0 it is used to map the 0-5volt signal from the AFM into a digital value. You may find this map usefull if you convert from a AFM to MAF setup. The map has 32 data points data value range is 127-255. This is an advanced topic, you most likely will not touch this map for general tuning."
	040100 Address          =0xF0
	040150 Flags            =0x30
	040200 ZEq              =X,TH|0|0|0|0|
	040203 XOutType         =0x4
	040304 YOutType         =0x4
