35;&#254;&#247;&#229;&#237;&#224;, &#227;&#232;&#241;&#242;&#229;&#240;&#229;&#231;&#232;&#241;&#237;&#251;&#233; &#239;&#240;&#232;&#231;&#237;&#224;&#234; == 0. &#202; &#225;&#224;&#231;&#229; &#239;&#240;&#232;&#225;&#224;&#226;&#235;&#255;&#229;&#242;&#241;&#255; &#226;&#251;&#225;&#240;&#224;&#237;&#237;&#251;&#233; idle-up &#247;&#235;&#229;&#237; 0 &#232; &#240;&#229;&#230;&#232;&#236;&#237;&#224;&#255; &#234;&#238;&#237;&#241;&#242;&#224;&#237;&#242;&#224;; &#231;&#224;&#242;&#229;&#236; &#226;&#238;&#231;&#236;&#238;&#230;&#237;&#251; &#237;&#232;&#230;&#237;&#229;&#229; &#238;&#227;&#240;&#224;&#237;&#232;&#247;&#229;&#237;&#232;&#229; &#232; &#239;&#238;&#228;&#236;&#229;&#237;&#224; &#246;&#229;&#235;&#232;.&#013;&#010;&#194;&#235;&#232;&#255;&#237;&#232;&#229;: &#200;&#231;&#236;&#229;&#237;&#255;&#229;&#242; &#246;&#229;&#235;&#229;&#226;&#251;&#229; RPM &#242;&#238;&#235;&#252;&#234;&#238; &#239;&#240;&#232; &#226;&#251;&#225;&#238;&#240;&#229; &#253;&#242;&#238;&#233; &#225;&#224;&#231;&#251;. &#200;&#231;&#236;&#229;&#237;&#229;&#237;&#232;&#229; &#238;&#228;&#237;&#238;&#233; &#234;&#240;&#232;&#226;&#238;&#233; &#237;&#229; &#236;&#229;&#237;&#255;&#229;&#242; &#226;&#241;&#229; &#240;&#229;&#230;&#232;&#236;&#251; &#245;&#238;&#235;&#238;&#241;&#242;&#238;&#227;&#238; &#245;&#238;&#228;&#224;.&#013;&#010;&#194;&#224;&#230;&#237;&#238;: &#206;&#225;&#238;&#231;&#237;&#224;&#247;&#229;&#237;&#232;&#255; MT/AT, Settled &#232; High750 &#241;&#238;&#245;&#240;&#224;&#237;&#229;&#237;&#251; &#232;&#231; &#240;&#224;&#231;&#236;&#229;&#242;&#234;&#232;; &#242;&#238;&#247;&#237;&#251;&#233; &#226;&#251;&#225;&#238;&#240; &#238;&#239;&#240;&#229;&#228;&#229;&#235;&#255;&#229;&#242;&#241;&#255; &#244;&#235;&#224;&#227;&#224;&#236;&#232;, &#224; &#237;&#229; &#242;&#238;&#235;&#252;&#234;&#238; &#242;&#229;&#236;&#239;&#229;&#240;&#224;&#242;&#243;&#240;&#238;&#233; &#232;&#235;&#232; &#231;&#237;&#224;&#247;&#229;&#237;&#232;&#229;&#236; 750. &#221;&#242;&