	      /* seed&key dll for DAQ privilege */ ""
	      /* seed&key dll for PGM privilege */ ""
	  /end SEED_KEY
  
	  /begin TP_BLOB
	      /* CCP version       */ 0x200
		  /* Blob version      */ 0x202
		  /* CAN msg ID - send */ 0x200
		  /* CAN msg ID - recv */ 0x210
		  /* station address   */ 0x1234
		  /* byte order        */ 1
          
		  /begin CAN_PARAM
