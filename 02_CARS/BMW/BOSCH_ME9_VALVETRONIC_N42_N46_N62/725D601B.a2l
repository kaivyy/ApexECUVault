    "Bedingung minimaler Tankfuellstand fuer Diagnosefunkionen"
    UBYTE
    B_TRUE
    1
    100
    0
    1

    BIT_MASK 0x1
    FORMAT "%13.11"
    
    ECU_ADDRESS 0x403BDE
    /begin IF_DATA ASAP1B_CCP KP_BLOB 0x00 0x403BDE 1 /end IF_DATA
    /begin IF_DATA ASAP1B_ADDRESS  KP_BLOB 0x403BDE /end IF_DATA
    /begin IF_DATA ETK  KP_BLOB 0x403BDE INTERN 0x1 /end IF_DATA
    /begin IF_DATA ASAP1B_KWP2000  KP_BLOB  0x403BDE  INTERN  0x1  /end IF_DATA 

/end MEASUREMENT

