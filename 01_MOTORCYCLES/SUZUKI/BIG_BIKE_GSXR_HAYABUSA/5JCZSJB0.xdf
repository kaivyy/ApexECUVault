    <decimalpl>0</decimalpl>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X/2.56">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0xE012" flags="0x0">
    <title>ALS Max Active Time</title>
    <description>Safety timer: after this long continuously active, ALS drops out until START is released. Default 2000 counts = 10 s. @0xBF00E</description>
    <CATEGORYMEM index="0" category="38" />
    <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0xBF00E" mmedelementsizebits="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
