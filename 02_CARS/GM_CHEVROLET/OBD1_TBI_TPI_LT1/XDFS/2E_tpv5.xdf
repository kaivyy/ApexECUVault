  <XDFTABLE uniqueid="0x3169" flags="0x0">
    <title>PRN4321 Decoder Table</title>
    <description>bits 0-3 of L008A are P,C,B,A&#013;&#010;&#013;&#010;0000 = 3 = 0&#009;5&#013;&#010;0001 = - = 1&#009;4&#013;&#010;0010 = - = 2&#009;4&#013;&#010;0011 = R = 3&#009;2&#013;&#010;0100 = - = 4&#009;4&#013;&#010;0101 = 2 = 5&#009;6&#013;&#010;0110 = P = 6&#009;1&#013;&#010;0111 = - = 7&#009;4&#013;&#010;1000 = - = 8&#009;4&#013;&#010;1001 = 4 = 9&#009;4&#013;&#010;1010 = N = 10&#009;3&#013;&#010;1011 = - = 11&#009;4&#013;&#010;1100 = 1 = 12&#009;7&#013;&#010;1101 = - = 13&#009;4&#013;&#010;1110 = - = 14&#009;4&#013;&#010;1111 = - = 15&#009;4&#013;&#010;&#013;&#010;1=P&#013;&#010;2=R&#013;&#010;3=N&#013;&#010;4=4&#013;&#010;5=3&#013;&#010;6=2&#013;&#010;7=1</description>
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedelementsizebits="8" mmedmajorstridebits="-32" />
      <indexcount>1</indexcount>
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <LABEL index="0" value="0.00" />
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
    <XDFAXIS id="y" uniqueid="0x0">
      <EMBEDDEDDATA mmedelementsizebits="8" mmedmajorstridebits="-32" />
      <units>Switch Combos (PCBA in Binary)</units>
      <indexcount>16</indexcount>
