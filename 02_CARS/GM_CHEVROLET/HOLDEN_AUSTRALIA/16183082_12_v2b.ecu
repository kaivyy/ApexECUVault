/*xlabel                    =,
/*xaxis                     =,,
};

/* Item 312: MALFUNCTION FLAG  - WORD 3 */

	Bit 0	= Code 38 - Not used
	Bit 1	= Code 37 - Not used
	Bit 2	= Code 36 - Vacuum leak
	Bit 3	= Code 35 - Idle air control motor error
	Bit 4 = Code 34 - MAP low
	Bit 5 = Code 33 - MAP high
	Bit 6 = Code 32 - Not used
	Bit 7 = Code 31 - Theft deterrant input missing

