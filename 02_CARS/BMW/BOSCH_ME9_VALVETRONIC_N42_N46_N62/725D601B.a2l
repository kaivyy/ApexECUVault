    "Nicht benutzt"
    UWORD
    B_TRUE
    1
    100
    0
    1

    BIT_MASK 0x10
    FORMAT "%13.11"
    
    ECU_ADDRESS 0x3FE416
    /begin IF_DATA ASAP1B_CCP KP_BLOB 0x00 0x3FE416 2 /end IF_DATA
    /begin IF_DATA ASAP1B_ADDRESS  KP_BLOB 0x3FE416 /end IF_DATA
    /begin IF_DATA ETK  KP_BLOB 0x3FE416 INTERN 0x2 /end IF_DATA
    /begin IF_DATA ASAP1B_KWP2000  KP_BLOB  0x3FE416  INTERN  0x2  /end IF_DATA 

/end MEASUREMENT

