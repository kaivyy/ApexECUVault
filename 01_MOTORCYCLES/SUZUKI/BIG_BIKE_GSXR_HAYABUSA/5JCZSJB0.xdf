    <decimalpl>0</decimalpl>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X/2.56">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
