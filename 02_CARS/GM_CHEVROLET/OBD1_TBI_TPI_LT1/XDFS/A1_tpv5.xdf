  <XDFCONSTANT uniqueid="0x3457">
    <title>KINJXBC5 in Lb/Hr</title>
    <description>single fire mode, so flow rate is actually doubled, but this is accounted for in the equation.</description>
    <CATEGORYMEM index="0" category="15" />
    <EMBEDDEDDATA mmedaddress="0x6C4" mmedelementsizebits="16" />
    <units>Lb/Hr</units>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="(((1/(144.4/X))*3600)/453.59237)/2">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
