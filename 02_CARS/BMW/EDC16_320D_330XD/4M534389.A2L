    "correction value for engine temperature dependent PiI2 quantity correction"
    MAP
    0xDC768
    Kf_Xs16_Ys16_Ws16
    10.00000
    InjMassInj
    0.00
    10.00000

    FORMAT "%8.5"
    EXTENDED_LIMITS -327.6800 327.6700
    
    /begin IF_DATA ASAP1B_CCP
	    DP_BLOB
		  0x00
		  0xDC768
		  0x14
    /end IF_DATA
    /begin IF_DATA ETK 
	    DP_BLOB 
		  0xDC768 
		  0x14 
    /end IF_DATA 
    /begin IF_DATA ASAP1B_KWP2000 
	    DP_BLOB 
		  0xDC768 
		  0x14 
    /end IF_DATA 
    /begin IF_DATA ASAP1B_MCMESS 
	    DP_BLOB 
		  0xDC768 
		  0x14 
    /end IF_DATA 

    /begin AXIS_DESCR

        STD_AXIS
        Eng_nAvrg
        EngN
        2
        0.00
        6000.000

        FORMAT "%8.3"
        EXTENDED_LIMITS -32768.00 32767.00
        DEPOSIT ABSOLUTE

    /end AXIS_DESCR

    /begin AXIS_DESCR

        STD_AXIS
        InjCtl_qSetUnBal
        InjMassCyc
        2
        0.00
        327.6700

        FORMAT "%8.4"
        EXTENDED_LIMITS -327.6800 327.6700
        DEPOSIT ABSOLUTE

    /end AXIS_DESCR

/end CHARACTERISTIC

