    "Meßpunkt für Verhältnis ASR-Anforderungsmoment / Maximalmoment"
    SWORD
    Prc
    1
    100
    -400.0000
    399.9878

    
    FORMAT "%8.4"
    
    ECU_ADDRESS 0x8FE376
    /begin IF_DATA ASAP1B_CCP
	    KP_BLOB
		  0x00
		  0x8FE376
		  0x2
    /end IF_DATA
    /begin IF_DATA ETK 
	    KP_BLOB 
		  0x8FE376 
          1 
		  0x2 
    /end IF_DATA 
    /begin IF_DATA ASAP1B_KWP2000 
	    KP_BLOB 
		  0x8FE376 
          EXTERN 
		  0x2 
    /end IF_DATA 
    /begin IF_DATA ASAP1B_MCMESS 
	    /begin KP_BLOB 
		  0x8FE376 
          EXTERN 
		  0x2 
	    /end KP_BLOB 
    /end IF_DATA 

/end MEASUREMENT

