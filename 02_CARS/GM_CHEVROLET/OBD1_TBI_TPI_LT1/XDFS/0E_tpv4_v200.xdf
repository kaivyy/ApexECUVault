	040011 DescSize         =0x1AD
	040010 Desc             ="Title: Fast PE Entry Delay Reduction vs. RPM\r\n\r\nLocation: 4C7E\r\n\r\nUsage: Power Enrichment Parameters\r\n\r\nTips: Table represents fraction of time needed to enter PE relative to the time normally needed. A value of 10 would be 1/10 the time needed to normally enter PE, when these values are used instead to compute the delay for PE. Value at L4917 \" PE Delay Time\" determines time to enter/exit PE.\r\n\r\nConversion: Factor = 1 * X\r\n"
	040100 Address          =0x4C7E
	040200 ZEq              =1 * X,TH|0|0|0|0|
	040304 YOutType         =0x4
	040210 DecimalPl        =0x0
