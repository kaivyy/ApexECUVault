	020005 Title            ="Shutdown Timer"
	020011 DescSize         =0xB8
	020010 Desc             ="Title: Shutdown Timer\r\n\r\nLocation: 4009\r\n\r\nUsage: $0E Parameters\r\n\r\nTips: Time delay for some PCM functions to cease after ignition is shut off.\r\n\r\nConversion: Sec. = 0.012474 * X\r\n\r\n"
