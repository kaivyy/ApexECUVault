  <XDFFLAG uniqueid="0xE000">
    <title>Auto-Shift :: Enable</title>
    <description>0x80 = auto-upshift ON. At each per-gear RPM target it pulses the PAIR output to kick the air ram; no spark cut (the factory quickshifter handles that). Ships OFF. UNVERIFIED - bench first. @0xBF010</description>
    <CATEGORYMEM index="0" category="38" />
    <EMBEDDEDDATA mmedaddress="0xBF010" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <mask>0x80</mask>
  </XDFFLAG>
  <XDFFLAG uniqueid="0xE001">
    <title>Auto-Shift :: Bench Test Output</title>
    <description>0x80 = hold the PAIR output asserted (no shifting) so you can confirm on the bench which pin / relay it drives. Set back to 0 for normal use. @0xBF011</description>
    <CATEGORYMEM index="0" category="38" />
    <EMBEDDEDDATA mmedaddress="0xBF011" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <mask>0x80</mask>
  </XDFFLAG>
  <XDFCONSTANT uniqueid="0xE002" flags="0x0">
    <title>Auto-Shift :: Pulse Length</title>
    <description>How long the PAIR output is held per shift, in ~5 ms task ticks (20 ~= 100 ms). Tune to your air ram. @0xBF012</description>
    <CATEGORYMEM index="0" category="38" />
    <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0xBF012" mmedelementsizebits="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <units>ticks</units>
    <decimalpl>0</decimalpl>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0xE003" flags="0x0">
    <title>Auto-Shift :: Min Grip (WOT gate)</title>
    <description>Only auto-shift at or above this twist-grip angle, so it fires under power, not when rolling off. @0xBF014</description>
    <CATEGORYMEM index="0" category="38" />
    <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0xBF014" mmedelementsizebits="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
    <units>deg</units>
    <decimalpl>1</decimalpl>
    <datatype>0</datatype>
    <unittype>0</unittype>
    <DALINK index="0" />
    <MATH equation="X/364.08">
      <VAR id="X" />
    </MATH>
  </XDFCONSTANT>
  <XDFCONSTANT uniqueid="0xE004" flags="0x0">
    <title>Auto-Shift :: Re-arm RPM Drop</title>
    <description>After a shift, engine RPM must fall this far below the gear target before the next gear can fire. @0xBF016</description>
    <CATEGORYMEM index="0" category="38" />
    <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0xBF016" mmedelementsizebits="16" mmedmajorstridebits="0" mmedminorstridebits="0" />
