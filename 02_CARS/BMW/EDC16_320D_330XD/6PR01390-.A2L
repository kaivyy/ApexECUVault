    SYSTEM_CONSTANT "AFS_TRQDISABLE_MAP_X" "2"
    SYSTEM_CONSTANT "AFS_TRQDISABLE_MAP_Y" "2"
    SYSTEM_CONSTANT "AFS_TRQDYNCORR1_MAP_X" "7"
    SYSTEM_CONSTANT "AFS_TRQDYNCORR1_MAP_Y" "7"
