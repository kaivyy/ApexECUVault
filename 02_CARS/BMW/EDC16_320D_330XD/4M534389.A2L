    SYSTEM_CONSTANT "AIRCTL_FACNQPARADPKP_MAP_Y" "8"
    SYSTEM_CONSTANT "AIRCTL_FACNQPAR_MAP_X" "16"
    SYSTEM_CONSTANT "AIRCTL_FACNQPAR_MAP_Y" "16"
    SYSTEM_CONSTANT "AIRCTL_FACPRESDIFFCOR_CUR_X" "8"
    SYSTEM_CONSTANT "AIRCTL_FACTVACTLATCOR_CUR_X" "6"
    SYSTEM_CONSTANT "AIRCTL_FACTVACTLCTCOR_CUR_X" "6"
    SYSTEM_CONSTANT "AIRCTL_MDESBASDEF_MAP_X" "16"
    SYSTEM_CONSTANT "AIRCTL_MDESBASDEF_MAP_Y" "16"
