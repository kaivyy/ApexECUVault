    "Bedingung starke Beschleunigungsanreicherung"
    UBYTE
    B_TRUE
    1
    100
    0
    1

    BIT_MASK 0x1
    FORMAT "%13.11"
    
    ECU_ADDRESS 0x3FBD67
    /begin IF_DATA ASAP1B_CCP KP_BLOB 0x00 0x3FBD67 1 /end IF_DATA
    /begin IF_DATA ASAP1B_ADDRESS  KP_BLOB 0x3FBD67 /end IF_DATA
    /begin IF_DATA ETK  KP_BLOB 0x3FBD67 INTERN 0x1 /end IF_DATA
    /begin IF_DATA ASAP1B_KWP2000  KP_BLOB  0x3FBD67  INTERN  0x1  /end IF_DATA 

/end MEASUREMENT

