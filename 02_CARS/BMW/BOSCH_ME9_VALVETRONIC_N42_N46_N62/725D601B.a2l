    "Status Fehlerpfad: Diagnose LOCAN-Timeout VVT-Schnittstelle"
    UWORD
    dez
    1
    100
    0
    65535

    
    FORMAT "%8.2"
    
    ECU_ADDRESS 0x3FE3E0
    /begin IF_DATA ASAP1B_CCP KP_BLOB 0x00 0x3FE3E0 2 /end IF_DATA
    /begin IF_DATA ASAP1B_ADDRESS  KP_BLOB 0x3FE3E0 /end IF_DATA
    /begin IF_DATA ETK  KP_BLOB 0x3FE3E0 INTERN 0x2 /end IF_DATA
    /begin IF_DATA ASAP1B_KWP2000  KP_BLOB  0x3FE3E0  INTERN  0x2  /end IF_DATA 

/end MEASUREMENT

