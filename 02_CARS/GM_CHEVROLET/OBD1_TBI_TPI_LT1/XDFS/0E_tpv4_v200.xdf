%%CONSTANT%%
	000002 UniqueID         =0x70B2
	000004 VisLevel         =0x1
	000100 Cat0ID           =0x1
	020005 Title            ="PROM ID"
	020011 DescSize         =0xD4
	020010 Desc             ="Title: PROM ID\r\n\r\nLocation: 4000\r\n\r\nUsage: $0E Parameters\r\n\r\nTips: Tracking different chip versions. This can be changed to whatever you wish. Doesn't affect calibration at all.  \r\n\r\nConversion: ID = 1 * X\r\n  \r\n"
	020020 Units            ="ID"
	020050 SizeInBits       =0x10
	020100 Address          =0x4000
	020200 Equation         =1 * X,TH|0|0|0|0|
	020210 DecimalPl        =0x0
%%END%%

