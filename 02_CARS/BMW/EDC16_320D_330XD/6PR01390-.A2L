    SYSTEM_CONSTANT "AIRCTL_FACNQPARADPKP_MAP_Y" "8"
    SYSTEM_CONSTANT "AIRCTL_FACNQPAR_MAP_X" "16"
    SYSTEM_CONSTANT "AIRCTL_FACNQPAR_MAP_Y" "16"
