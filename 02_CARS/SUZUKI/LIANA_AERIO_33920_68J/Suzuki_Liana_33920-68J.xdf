    <title>Injector_LagTime_ByVoltage</title>
    <description>&#199;&#224;&#226;&#232;&#241;&#232;&#236;&#251;&#233; &#238;&#242; &#237;&#224;&#239;&#240;&#255;&#230;&#229;&#237;&#232;&#255; &#226;&#240;&#229;&#236;&#229;&#237;&#237;&#238;&#233; &#247;&#235;&#229;&#237; &#243;&#239;&#240;&#224;&#226;&#235;&#229;&#237;&#232;&#255; &#244;&#238;&#240;&#241;&#243;&#237;&#234;&#224;&#236;&#232;, &#232;&#241;&#239;&#238;&#235;&#252;&#231;&#243;&#229;&#236;&#251;&#233; &#234;&#224;&#234; &#234;&#224;&#235;&#232;&#225;&#240;&#238;&#226;&#234;&#224; &#231;&#224;&#228;&#229;&#240;&#230;&#234;&#232;/latency (lag time).&#013;&#010;X: &#237;&#224;&#239;&#240;&#255;&#230;&#229;&#237;&#232;&#229; &#239;&#232;&#242;&#224;&#237;&#232;&#255;, &#194;; &#238;&#241;&#252; 0x6FD94, 5 &#242;&#238;&#247;&#229;&#234; (6.5..16.5).&#013;&#010;Z: &#226;&#240;&#229;&#236;&#229;&#237;&#237;&#238;&#233; &#247;&#235;&#229;&#237;, &#236;&#241;; &#241;&#242;&#238;&#234; 3.050..0.530 &#236;&#241; &#239;&#240;&#232; &#238;&#241;&#232; 6.5..16.5 &#194;.&#013;&#010;&#196;&#224;&#237;&#237;&#251;&#229;: 0x6FDA8, 5 &#241;&#242;&#238;&#235;&#225;&#246;&#238;&#226; x 1 &#241;&#242;&#240;&#238;&#234;, uint16 BE. &#210;&#229;&#234;&#243;&#249;&#224;&#255; &#244;&#238;&#240;&#236;&#243;&#235;&#224; XDF: X*0.001.&#013;&#010;&#207;&#229;&#240;&#229;&#241;&#247;&#184;&#242; &#226; ROM: X*0.001; &#228;&#229;&#241;&#234;&#240;&#232;&#239;&#242;&#238;&#240; 0x57504. &#199;&#237;&#224;&#247;&#229;&#237;&#232;&#255; &#232;&#241;&#245;&#238;&#228;&#237;&#238;&#227;&#238; &#241;&#242;&#238;&#234;&#238;&#226;&#238;&#227;&#238; BIN &#239;&#238;&#241;&#235;&#229; &#239;&#229;&#240;&#229;&#241;&#247;&#184;&#242;&#224;: 0.53..3.05.&#013;&#010;&#200;&#241;&#239;&#238;&#235;&#252;&#231;&#238;&#226;&#224;&#237;&#232;&#229;: 0x33AC0 &#232;&#237;&#242;&#229;&#240;&#239;&#238;&#235;&#232;&#240;&#243;&#229;&#242; &#228;&#229;&#241;&#234;&#240;&#232;&#239;&#242;&#238;&#240; 0x57504 &#232; &#231;&#224;&#239;&#232;&#241;&#251;&#226;&#224;&#229;&#242; A254; &#231;&#237;&#224;&#247;&#229;&#237;&#232;&#229; &#247;&#232;&#242;&#224;&#229;&#242;&#241;&#255; &#237;&#232;&#231;&#234;&#238;&#243;&#240;&#238;&#226;&#237;&#229;&#226;&#251;&#236; &#239;&#243;&#242;&#184;&#236; &#244;&#232;&#234;&#241;&#224;&#246;&#232;&#232; &#234;&#238;&#236;&#224;&#237;&#228;&#251; &#244;&#238;&#240;&#241;&#243;&#237;&#238;&#234;.&#013;&#010;&#194;&#235;&#232;&#255;&#237;&#232;&#229;: &#200;&#231;&#236;&#229;&#237;&#255;&#229;&#242; &#231;&#224;&#226;&#232;&#241;&#232;&#236;&#243;&#254; &#238;&#242; &#237;&#224;&#239;&#240;&#255;&#230;&#229;&#237;&#232;&#255; &#247;&#224;&#241;&#242;&#252; &#226;&#240;&#229;&#236;&#229;&#237;&#237;&#238;&#233; &#238;&#225;&#240;&#224;&#225;&#238;&#242;&#234;&#232;. &#221;&#242;&#238; &#238;&#242;&#228;&#229;&#235;&#252;&#237;&#224;&#255; &#245;&#224;&#240;&#224;&#234;&#242;&#229;&#240;&#232;&#241;&#242;&#232;&#234;&#224; &#238;&#242; &#225;&#224;&#231;&#238;&#226;&#238;&#227;&#238; &#240;&#224;&#241;&#245;&#238;&#228;&#224;/&#239;&#240;&#238;&#232;&#231;&#226;&#238;&#228;&#232;&#242;&#229;&#235;&#252;&#237;&#238;&#241;&#242;&#232; &#244;&#238;&#240;&#241;&#243;&#237;&#234;&#232;.&#013;&#010;&#194;&#224;&#230;&#237;&#238;: &#212;&#238;&#240;&#236;&#224; &#232; &#232;&#241;&#239;&#238;&#235;&#252;&#231;&#238;&#226;&#224;&#237;&#232;&#229; &#239;&#238;&#228;&#228;&#229;&#240;&#230;&#232;&#226;&#224;&#254;&#242; &#232;&#237;&#242;&#229;&#240;&#239;&#240;&#229;&#242;&#224;&#246;&#232;&#254; &#231;&#224;&#228;&#229;&#240;&#230;&#234;&#232;, &#237;&#238; &#237;&#229; &#231;&#224;&#236;&#229;&#237;&#255;&#254;&#242; &#232;&#231;&#236;&#229;&#240;&#229;&#237;&#232;&#229; &#244;&#224;&#234;&#242;&#232;&#247;&#229;&#241;&#234;&#238;&#227;&#238; dead time &#244;&#238;&#240;&#241;&#243;&#237;&#234;&#232; &#241; &#228;&#224;&#237;&#237;&#251;&#236; &#228;&#240;&#224;&#233;&#226;&#229;&#240;&#238;&#236;. &#205;&#229; &#241;&#247;&#232;&#242;&#224;&#242;&#252; &#243;&#237;&#232;&#226;&#229;&#240;&#241;&#224;&#235;&#252;&#237;&#238;&#233; &#228;&#2