    "‹ber PT-1 gefiltertes dffgen-Signal"
    UBYTE
    rel_ub_b100
    1
    100
    0
    100

    
    FORMAT "%5.1"
    
    ECU_ADDRESS 0x403457
    /begin IF_DATA ASAP1B_CCP KP_BLOB 0x00 0x403457 1 /end IF_DATA
    /begin IF_DATA ASAP1B_ADDRESS  KP_BLOB 0x403457 /end IF_DATA
    /begin IF_DATA ETK  KP_BLOB 0x403457 INTERN 0x1 /end IF_DATA
    /begin IF_DATA ASAP1B_KWP2000  KP_BLOB  0x403457  INTERN  0x1  /end IF_DATA 

/end MEASUREMENT

