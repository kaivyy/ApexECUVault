  <XDFTABLE uniqueid="0x2A5" flags="0x0">
    <title>Fuel_DFCO_DiagFallbackLowLoadThreshold_ByRPM</title>
    <description>&#205;&#224;&#227;&#240;&#243;&#231;&#238;&#247;&#237;&#251;&#233; &#239;&#238;&#240;&#238;&#227; &#228;&#232;&#224;&#227;&#237;&#238;&#241;&#242;&#232;&#247;&#229;&#241;&#234;&#238;&#227;&#238; &#232;&#241;&#234;&#235;&#254;&#247;&#229;&#237;&#232;&#255; &#226; DFCO, &#237;&#229; &#238;&#225;&#251;&#247;&#237;&#224;&#255; &#234;&#224;&#240;&#242;&#224; &#226;&#245;&#238;&#228;&#224; &#239;&#238; &#237;&#224;&#227;&#240;&#243;&#231;&#234;&#229;.&#013;&#010;X: RPM, &#238;&#241;&#252; 0x71870, 11 float32 BE. Z: &#237;&#238;&#240;&#236;&#232;&#240;&#238;&#226;&#224;&#237;&#237;&#224;&#255; &#237;&#224;&#227;&#240;&#243;&#231;&#234;&#224; A7C0, U16 BE, X*0.001. &#209;&#242;&#238;&#234; 0.110 &#226;&#238; &#226;&#241;&#229;&#245; &#242;&#238;&#247;&#234;&#224;&#245;; &#227;&#232;&#241;&#242;&#229;&#240;&#229;&#231;&#232;&#241; 0.030.&#013;&#010;0x1E69C: &#244;&#235;&#224;&#227; &#236;&#224;&#235;&#238;&#233; &#237;&#224;&#227;&#240;&#243;&#231;&#234;&#232; AC04 &#243;&#241;&#242;&#224;&#237;&#224;&#226;&#235;&#232;&#226;&#224;&#229;&#242;&#241;&#255; &#239;&#240;&#232; Load &#060; &#234;&#224;&#240;&#242;&#224; - 0.03, &#241;&#237;&#232;&#236;&#224;&#229;&#242;&#241;&#255; &#239;&#240;&#232; Load &#062;= &#234;&#224;&#240;&#242;&#224;; &#236;&#229;&#230;&#228;&#243; &#239;&#238;&#240;&#238;&#227;&#224;&#236;&#232; &#241;&#238;&#245;&#240;&#224;&#237;&#255;&#229;&#242;&#241;&#255;.&#013;&#010;&#207;&#240;&#232; &#232;&#241;&#239;&#240;&#224;&#226;&#237;&#238;&#233; &#228;&#232;&#224;&#227;&#237;&#238;&#241;&#242;&#232;&#247;&#229;&#241;&#234;&#238;&#233; &#226;&#229;&#242;&#234;&#229; A92A=0 &#253;&#242;&#238;&#242; &#244;&#235;&#224;&#227; &#237;&#229; &#236;&#229;&#248;&#224;&#229;&#242; &#238;&#242;&#236;&#229;&#237;&#232;&#242;&#252; DFCO &#239;&#238; &#238;&#242;&#234;&#240;&#251;&#242;&#232;&#254; &#228;&#240;&#238;&#241;&#241;&#229;&#235;&#255;. &#207;&#240;&#232; A92A!=0 &#232; AC04=1 &#228;&#229;&#233;&#241;&#242;&#226;&#243;&#229;&#242; &#232;&#241;&#234;&#235;&#254;&#247;&#229;&#237;&#232;&#229; &#232;&#231; &#253;&#242;&#238;&#233; &#238;&#242;&#236;&#229;&#237;&#251;.&#013;&#010;&#211;&#226;&#229;&#235;&#232;&#247;&#229;&#237;&#232;&#229; &#240;&#224;&#241;&#248;&#232;&#240;&#255;&#229;&#242; &#238;&#225;&#235;&#224;&#241;&#242;&#252; &#236;&#224;&#235;&#238;&#233; &#237;&#224;&#227;&#240;&#243;&#231;&#234;&#232; &#228;&#235;&#255; &#232;&#241;&#234;&#235;&#254;&#247;&#229;&#237;&#232;&#255; &#232; &#236;&#238;&#230;&#229;&#242; &#236;&#229;&#237;&#255;&#242;&#252; &#226;&#238;&#231;&#226;&#240;&#224;&#242; &#242;&#238;&#239;&#235;&#232;&#226;&#224; &#239;&#240;&#232; &#237;&#229;&#232;&#241;&#239;&#240;&#224;&#226;&#237;&#238;&#241;&#242;&#232;. &#205;&#229; &#232;&#241;&#239;&#238;&#235;&#252;&#231;&#238;&#226;&#224;&#242;&#252; &#234;&#224;&#234; &#243;&#237;&#232;&#226;&#229;&#240;&#241;&#224;&#235;&#252;&#237;&#251;&#233; &#240;&#229;&#227;&#243;&#235;&#255;&#242;&#238;&#240; &#238;&#242;&#241;&#229;&#247;&#234;&#232; &#237;&#224; &#232;&#241;&#239;&#240;&#224;&#226;&#237;&#238;&#236; &#228;&#226;&#232;&#227;&#224;&#242;&#229;&#235;&#229;.</description>
