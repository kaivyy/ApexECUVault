  <XDFCONSTANT uniqueid="0xE00A" flags="0x0">
    <title>ALS Enable</title>
    <description>0x80 = rolling anti-lag ON; anything else = OFF (START button behaves stock). Ships OFF on a patched bin. @0xBF000</description>
    <CATEGORYMEM index="0" category="38" />
    <EMBEDDEDDATA mmedtypeflags="0x02" mmedaddress="0xBF000" mmedelementsizebits="8" mmedmajorstridebits="0" mmedminorstridebits="0" />
