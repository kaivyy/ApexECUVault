    "Fehlertyp min.: DV-E Fehler beim UMA-Lernen"
    UWORD
    B_TRUE
    1
    100
    0
    1

    BIT_MASK 0x200
    FORMAT "%13.11"
    
    ECU_ADDRESS 0x3FE424
    /begin IF_DATA ASAP1B_CCP KP_BLOB 0x00 0x3FE424 2 /end IF_DATA
    /begin IF_DATA ASAP1B_ADDRESS  KP_BLOB 0x3FE424 /end IF_DATA
    /begin IF_DATA ETK  KP_BLOB 0x3FE424 INTERN 0x2 /end IF_DATA
    /begin IF_DATA ASAP1B_KWP2000  KP_BLOB  0x3FE424  INTERN  0x2  /end IF_DATA 

/end MEASUREMENT

