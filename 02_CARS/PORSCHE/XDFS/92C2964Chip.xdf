	040005 Title            ="T_OverrunFuelCutoffMap29-a"
	040011 DescSize         =0x132
	040010 Desc             ="Fuel cutoff on decel map. When throttle returns closed on decel this map determines RPM at which fuel is cut, if you are above this RPM on decel fuel is cut. Fuel comes back on once RPM drops lower than this RPM. Map has 4 cells and the scale is CHT in DegC, this allows for diffrent cutoff during warmup."
	040100 Address          =0x67C7
	040150 Flags            =0x30
	040200 ZEq              =X*40,TH|0|0|0|0|
	040203 XOutType         =0x4
