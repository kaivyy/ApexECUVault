  <XDFTABLE uniqueid="0x4395" flags="0x0">
    <title>Mode 0/7 Address Transmit Table 2</title>
    <description>first byte is same as table 1&#013;&#010;   2    MODE WORD FOR INSTRUMENT PANEL&#013;&#010;          0     NOT USED&#013;&#010;          1      1 = FUEL SYSTEM DISABLED BY VATS&#013;&#010;          2     NOT USED&#013;&#010;          3      1 = MALF 24 DETECTED&#013;&#010;          4     NOT USED&#013;&#010;          5      1 = LOW COOLANT&#013;&#010;          6      1 = MALF 14 OR 15 DETECTED&#013;&#010;          7     NOT USED&#013;&#010;   3            FILTMPH       VEHICLE SPEED           MPH = N&#013;&#010;   4            KREDLINE      REDLINE RPM             RPM = N*100&#013;&#010;   5            ADBAT         BATTERY VOLTAGE      VOLTS = N/10&#013;&#010;   6            ACUMFUEL      ACCUMULATED FUEL FOR DIC (MSB)&#013;&#010;   7            ACUMFUEL+1    &quot;&quot; (LSB)         MSEC = (MSB*256 + LSB)/65.536&#013;&#010;   8            KDISF         SINGLE INJECTOR FLOW RATE IN GALLONS/HOUR (MSB)&#013;&#010;   9            KDISF+1      &quot;&quot; (LSB) G/H = (MSB*256 + LSB)/6144&#013;&#010;  10     </description>
    <CATEGORYMEM index="0" category="24" />
    <XDFAXIS id="x" uniqueid="0x0">
      <EMBEDDEDDATA mmedelementsizebits="8" mmedmajorstridebits="-32" />
      <units>see notes</units>
      <indexcount>1</indexcount>
      <datatype>0</datatype>
      <unittype>0</unittype>
      <DALINK index="0" />
      <LABEL index="0" value="0.00" />
      <MATH equation="X">
        <VAR id="X" />
      </MATH>
    </XDFAXIS>
