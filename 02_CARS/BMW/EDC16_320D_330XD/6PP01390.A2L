    SYSTEM_CONSTANT "AIRCTL_FACNQPARADPKD_MAP_X" "8"
    SYSTEM_CONSTANT "AIRCTL_FACNQPARADPKD_MAP_Y" "8"
    SYSTEM_CONSTANT "AIRCTL_FACNQPARADPKI_MAP_X" "8"
    SYSTEM_CONSTANT "AIRCTL_FACNQPARADPKI_MAP_Y" "8"
    SYSTEM_CONSTANT "AIRCTL_FACNQPARADPKP_MAP_X" "8"
    SYSTEM_CONSTANT "AIRCTL_FACNQPARADPKP_MAP_Y" "8"
    SYSTEM_CONSTANT "AIRCTL_FACNQPAR_MAP_X" "16"
    SYSTEM_CONSTANT "AIRCTL_FACNQPAR_MAP_Y" "16"
    SYSTEM_CONSTANT "AIRCTL_FACTVACTLATCOR_CUR_X" "6"
