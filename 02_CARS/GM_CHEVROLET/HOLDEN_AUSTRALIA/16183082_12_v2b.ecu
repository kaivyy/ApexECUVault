/*Item 262: Baro Adjustment offset to MAP A/D reading as a function of RPM & TPS  */
		BAROFS (tps, rpm) is an offset added to manifold pressure(MAP)
		to produce barometric pressure (BAR) (unit 0-94 [kPa, map])
		When the conditions for calculation are met, barometric pressure is
		calculated from baro = map + BAROFS[tps,rpm]. BAROFS[tps, rpm] is
		dependenant on the manifold and throttle bodies used.
{
/*startAddr		=08FD,
/*columns		=6,
/*rows		=3,
/*elementSize		=1,
/*bitMask		=0,
/*offset		=0,
/*mulOrDivOrBit		=0,
/*factor		=0.369003690036900369003690036900369,
/*map_name		=F59: Baro params - Baro Adjustment offset to MAP A/D reading vs RPM & TPS,
/*Ylabel	=RPM,
/*Yaxis		=1200 2400 3600,
/*Xlabel	=%Thrott Pos,
/*Xaxis		=37½50 62½75 87½100,,
};

