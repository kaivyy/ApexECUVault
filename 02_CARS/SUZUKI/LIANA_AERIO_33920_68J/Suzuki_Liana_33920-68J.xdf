#231;&#236;&#229;&#240;&#229;&#237;&#237;&#238;&#229; &#228;&#224;&#226;&#235;&#229;&#237;&#232;&#229; &#242;&#238;&#239;&#235;&#232;&#226;&#224;.&#013;&#010;&#207;&#240;&#232; 0x6C55D != 0 &#232;&#241;&#239;&#238;&#235;&#252;&#231;&#243;&#229;&#242;&#241;&#255; &#236;&#238;&#228;&#229;&#235;&#252;&#237;&#238;&#229; &#240;&#224;&#231;&#240;&#229;&#230;&#229;&#237;&#232;&#229;. &#221;&#242;&#238; &#237;&#229; &#234;&#224;&#240;&#242;&#224; AFR; &#239;&#240;&#238;&#232;&#231;&#226;&#238;&#235;&#252;&#237;&#238;&#229; &#243;&#226;&#229;&#235;&#232;&#247;&#229;&#237;&#232;&#229; &#236;&#229;&#237;&#255;&#229;&#242; &#234;&#238;&#236;&#239;&#229;&#237;&#241;&#224;&#246;&#232;&#254; &#228;&#224;&#226;&#235;&#229;&#237;&#232;&#255;.</description>
