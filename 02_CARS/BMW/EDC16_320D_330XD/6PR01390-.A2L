    SYSTEM_CONSTANT "AIRCTL_APCORRGN_CUR_X" "6"
    SYSTEM_CONSTANT "AIRCTL_APSCORRGN_CUR_X" "25"
    SYSTEM_CONSTANT "AIRCTL_APSCOR_CUR_X" "8"
