    "Bedingung: Ersatzwert DVSTE"
    UWORD
    B_TRUE
    1
    100
    0
    1

    BIT_MASK 0x40
    FORMAT "%13.11"
    
    ECU_ADDRESS 0x3FE446
    /begin IF_DATA ASAP1B_CCP KP_BLOB 0x00 0x3FE446 2 /end IF_DATA
    /begin IF_DATA ASAP1B_ADDRESS  KP_BLOB 0x3FE446 /end IF_DATA
    /begin IF_DATA ETK  KP_BLOB 0x3FE446 INTERN 0x2 /end IF_DATA
    /begin IF_DATA ASAP1B_KWP2000  KP_BLOB  0x3FE446  INTERN  0x2  /end IF_DATA 

/end MEASUREMENT

