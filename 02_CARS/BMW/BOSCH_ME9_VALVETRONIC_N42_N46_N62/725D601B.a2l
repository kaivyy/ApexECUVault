              /* Load mode   */ 1 
          
		  /begin CHECKSUM 
              0x010201 
              1 
              1 
              RequestRoutineResults 
              RNC_RESULT 0x23 
          /end CHECKSUM 
          
          /begin FLASH_COPY 
              NOFLASHBACK 
              3 
              RequestRoutineResults 
              RAM_InitByECU 
              0x86 
              COPY_FRAME 1 
              RNC_RESULT 0x23 0xFB 0xFC 
          /end FLASH_COPY 
          
          BAUD_DEF 
