%%TABLE%%
	000002 UniqueID         =0x78BE
	040005 Title            ="   VE TABLE - F29 - (SEE NOTES)"
	040011 DescSize         =0x385
	040010 Desc             ="F29\r\nBASE PULSE VOLUMETRIC EFFICIENCY VS RPM AND MAP\r\nTABLE VALUE = PERCENT*2.56\r\n\r\nMax value is 100%, anything over is ignored...\r\nVE is an added value.....F29 is vac only (open throttle), F29E is vac only (closed throttle), and F30 is based on rpm. So, for boosted conditions, F30 will be pulling a value based only on rpm and will be added to the \"100\" column in F29 for a total VE value. Fuel can be added in boost a number of ways, either by adding in the F29 table (up to 4k and affects ALL boost levels), in the F30 table (being a little more fine tuned with broader rpm range but still affects ALL boost levels), or in the F77 table (based on boost itself, but can tune for different levels of boost). In essence, VE works this way....F30 is always active, always using it's table as a lookup for VE and storing. Then it does a check for either open or closed throttle....if open, it uses a v"
	040100 Address          =0x6F5
	040200 ZEq              =0.390625 * X,TH|0|0|0|0|
	040203 XOutType         =0x4
	040304 YOutType         =0x4
	040230 RangeLow         =0.0000
	040240 RangeHigh        =255.0000
	040300 Rows             =0xA
	040305 Cols             =0xD
	040320 XUnits           ="Kpa"
	040325 YUnits           ="Rpm"
	040330 ZUnits           =""
	040350 XLabels          =20,25,30,35,40,45,50,55,60,70,80,90,100
	040352 XLabelType       =0x4
	040354 XEq              =X,TH|0|0|0|0|
	040360 YLabels          =400,800,1200,1600,2000,2400,2800,3200,3600,4000+
	040362 YLabelType       =0x4
	040364 YEq              =X,TH|0|0|0|0|
	040660 XAxisMin         =1000.000000
	040670 XAxisMax         =1000.000000
	040760 YAxisMin         =1000.000000
	040770 YAxisMax         =1000.000000
%%END%%

