    "Fehlerzähler ""Hauptrelais öffnet zu früh"",Zählerwert nach SG Ini."
    UBYTE
    OneToOne
    1
    100
    0.00
    255.0

    
    FORMAT "%5.1"
    
    ECU_ADDRESS 0x8FEDA6
    /begin IF_DATA ASAP1B_CCP
	    KP_BLOB
		  0x00
		  0x8FEDA6
		  0x1
    /end IF_DATA
    /begin IF_DATA ETK 
	    KP_BLOB 
		  0x8FEDA6 
          1 
		  0x1 
    /end IF_DATA 
    /begin IF_DATA ASAP1B_KWP2000 
